"type":"npc","x":744.0,"y":782.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.woman"},{"name":"sprite","type":"string","value":"folk.woman#2"},{"name":"wander","type":"bool","value":false},{"name":"say","type":"string","value":"[[\"n\", \"An old serving woman bows low. “Welcome, Miss Lin. The whole house has been waiting for you.”\", \"一个老婆子深深一福。“林姑娘来了。一家子都等着呢。”\", \"1d29fe6ccdb9\"]]"},{"name":"until","type":"string","value":"31-d7"},{"name":"face","type":"string","value":"N"}]},{"id":266,"name":"npc-3","type":"npc","x":552.0,"y":526.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.maiden"},{"name":"sprite","type":"string","value":"f_maiden"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"A maid hurries down the passage with a covered dish, and not a sound from her feet.\", \"一个丫头捧着盖碗从夹道里快步走过，脚下一点声儿也没有。\", \"0414a8f37ad8\"]]"},{"name":"until","type":"string","value":"31-d7"},{"name":"face","type":"string","value":"N"},{"name":"when","type":"string","value":"node:d4"}]},{"id":267,"name":"npc-4","type":"npc","x":744.0,"y":270.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.woman"},{"name":"sprite","type":"string","value":"folk.woman#7"},{"name":"wander","type":"bool","value":false},{"name":"say","type":"string","value":"[[\"n\", \"A woman scrubbing a pot looks you up and down. “Looking for Zhou Rui's? Just there, by the gate.”\", \"一个刷锅的媳妇上下打量你。“找周瑞家的？就在门边上。”\", \"12be8ca4225b\"]]"},{"name":"face","type":"string","value":"S"},{"name":"when","type":"string","value":"node:d8"}]},{"id":268,"name":"npc-5","type":"npc","x":520.0,"y":494.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.child"},{"name":"sprite","type":"string","value":"f_child"},{"name":"wander","type":"bool","value":true},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"A small boy in a padded jacket stares at Ban'er, and Ban'er stares back.\", \"一个穿棉袄的小小子盯着板儿看，板儿也盯着他看。\", \"25950d89251d\"]]"},{"name":"when","type":"string","value":"node:d8"}]},{"id":269,"name":"npc-6","type":"npc","x":552.0,"y":462.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.maiden"},{"name":"sprite","type":"string","value":"f_maiden2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"A little maid with a tray stops dead. “The second mistress is coming down to eat. Hush!”\", \"一个端盘子的小丫头站住了。“奶奶下来吃饭了。别出声！”\", \"054a7747640a\"]]"},{"name":"until","type":"string","value":"31-g6"},{"name":"face","type":"string","value":"W"},{"name":"when","type":"string","value":"node:g3"}]},{"id":270,"name":"steps-maid","type":"npc","x":328.0,"y":334.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.maiden"},{"name":"sprite","type":"string","value":"f_maiden2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"steps-maid"},{"name":"until","type":"string","value":"31-d3"},{"name":"when","type":"string","value":"node:d1"},{"name":"view","type":"string","value":"2"},{"name":"intro","type":"string","value":"[[\"n\", \"So you're the new cousin from Yangzhou. They say the south plays a careful game. Show me.\", \"你就是扬州来的林姑娘？听说南边的人下棋最仔细。下一局我瞧瞧。\", \"6bc75c27e35c\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"Careful, and quick too. I'll tell the others.\", \"又仔细，又快。我去告诉她们。\", \"24d1b52891ea\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"The old lady's waiting, miss.\", \"老太太等着呢，姑娘。\", \"f7cb622686d5\"]]"}]},{"id":271,"name":"walk-nurse","type":"npc","x":936.0,"y":526.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.woman"},{"name":"sprite","type":"string","value":"folk.woman#2"},{"name":"wander","type":"bool","value":false},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"walk-nurse"},{"name":"until","type":"string","value":"31-d6a"},{"name":"when","type":"string","value":"node:d4"},{"name":"view","type":"string","value":"2"},{"name":"intro","type":"string","value":"[[\"n\", \"I play a game here while the mistresses talk. Sit a moment, miss. Nobody will see.\", \"太太们说话的工夫，我在这里摆一局。姑娘坐一坐，没人瞧见。\", \"980c5d1635bc\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"Your mother played like that. She never let a stone go to waste.\", \"你母亲当年也是这样下的，一个子儿也不肯白丢。\", \"7cb25edfe0b1\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"Go on, miss. Don't keep them waiting.\", \"去罢，姑娘，别叫她们等着。\", \"b21f085dc2af\"]]"}]},{"id":272,"name":"exit-the-rong-mansion--jm-rooms","type":"exit","x":233.6,"y":253.6,"width":12.8,"height":12.0,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"the-rong-mansion--jm-rooms"},{"name":"side","type":"string","value":"N"}]},{"id":273,"name":"exit-the-rong-mansion--xf-eastroom","type":"exit","x":537.6,"y":93.6,"width":12.8,"height":12.0,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"the-rong-mansion--xf-eastroom"},{"name":"side","type":"string","value":"N"}]},{"id":274,"name":"exit-the-rong-mansion--zhou-house","type":"exit","x":873.6,"y":61.6,"width":12.8,"height":12.0,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"the-rong-mansion--zhou-house"},{"name":"side","type":"string","value":"N"}]},{"id":275,"name":"exit-the-rong-mansion--wf-rooms","type":"exi