ame":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"A man on the bench with his chest out and his belly forward. “Where are you from, granny? Ha!”\", \"板凳上一个挺胸叠肚的人。“姥姥打那里来的？哈！”\", \"246d18dba730\"]]"},{"name":"until","type":"string","value":"31-g2"},{"name":"face","type":"string","value":"N"}]},{"id":213,"name":"npc-2","type":"npc","x":280.0,"y":670.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.official"},{"name":"sprite","type":"string","value":"f_official"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Go on, wait by the wall. Somebody'll be out.” He laughs, and the others laugh with him.\", \"“去，墙根底下等着，一会子就有人出来。”他一笑，大家都跟着笑。\", \"879c0d9f65bc\"]]"},{"name":"until","type":"string","value":"31-g2"},{"name":"face","type":"string","value":"E"}]},{"id":214,"name":"npc-3","type":"npc","x":1240.0,"y":734.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_farmer2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"A water-carrier sets down his buckets. “The Rong mansion? That's the one with the lions, granny. Don't go near the front.”\", \"挑水的放下担子。“荣府？就是门口有石狮子的那家。姥姥，可别往大门上去。”\", \"bc7d6ff17d7a\"]]"},{"name":"face","type":"string","value":"W"}]},{"id":215,"name":"npc-4","type":"npc","x":216.0,"y":414.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.woman"},{"name":"sprite","type":"string","value":"folk.woman#2"},{"name":"wander","type":"bool","value":false},{"name":"say","type":"string","value":"[[\"n\", \"A woman with a basket of washing. “The back street? Keep on round the corner.”\", \"挎着一篮衣裳的妇人。“后街？顺着墙角绕过去就是。”\", \"8daded4468c4\"]]"},{"name":"face","type":"string","value":"E"}]},{"id":216,"name":"npc-5","type":"npc","x":984.0,"y":558.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.child"},{"name":"sprite","type":"string","value":"f_child"},{"name":"wander","type":"bool","value":true},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"Children race past shrieking, a paper windmill held high.\", \"孩子们举着纸风车，尖叫着跑过去。\", \"0484555c0fb0\"]]"},{"name":"until","type":"string","value":"31-g3"},{"name":"when","type":"string","value":"node:g2"}]},{"id":217,"name":"npc-6","type":"npc","x":1112.0,"y":94.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.elder"},{"name":"sprite","type":"string","value":"f_elder"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"An old peddler with a tray of sugar figures. “Buy one for the boy, granny? No? Then mind your feet.”\", \"端着糖人盘子的老货郎。“给哥儿买一个？不买？那就看着脚底下。”\", \"7df291add05d\"]]"},{"name":"face","type":"string","value":"W"}]},{"id":218,"name":"npc-7","type":"npc","x":600.0,"y":734.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"hero.oldservant"},{"name":"sprite","type":"string","value":"oldservant"},{"name":"wander","type":"bool","value":false},{"name":"say","type":"string","value":"[[\"say\", \"oldservant\", \"Those idlers are having their fun. Don't wait by that wall.\", \"那几个闲人拿你取笑呢。别去墙角下傻等。\", \"a494a57e33dd\"]]"},{"name":"until","type":"string","value":"31-g2"},{"name":"face","type":"string","value":"W"},{"name":"when","type":"string","value":"node:g1"}]},{"id":219,"name":"npc-8","type":"npc","x":856.0,"y":94.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"hero.backchild"},{"name":"sprite","type":"string","value":"backchild"},{"name":"wander","type":"bool","value":false},{"name":"say","type":"string","value":"[[\"say\", \"backchild\", \"There are three Zhou Da-niangs here. Which one?\", \"我们这里周大娘有三个呢。你找哪一个？\", \"3ab937666e00\"]]"},{"name":"until","type":"string","value":"31-g3"},{"name":"face","type":"string","value":"W"},{"name":"when","type":"string","value":"node:g2"}]},{"id":220,"name":"lion-groom","type":"npc","x":1112.0,"y":670.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_porter"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"lion-groom"},{"name":"until","type":"string","value":"31-g2"},{"name":"when","type":"string","value":"node:g1"},{"name":"view","type":"string","value":"4"},{"name":"intro","type":"string","value":"[[\"n\", \"Hey, granny, this gate's for sedan chairs. Beat me at a game and I'll tell you which door's for you.\", \"老人家，这是走轿子的大门。赢我一局，我告诉你该走哪个门。\", \"82196caa6a56\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"Not bad for a country granny! The side gate, to the west. Mind the men on the bench.\", \"乡下老奶奶，倒有两下子！西边角门。小心板凳上那几位。\", \"1ea637a80891\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"West, granny. The side gate.\", \"往西，角门。\", \"842cabffc7ea\"]]"}]},{"id":221,"name":"toy-hawker","type":"npc","x":472.0,"y":94.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_porter"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"toy-hawker"},{"name":"until","type":"string","value":"31-g3"},{"name":"when","type":"string","value":"node:g2"},{"name":"view","type":"string","value":"4"},{"name":"intro","type":"string","value":"[[\"n\", \"A toy for the little one? Win a game and he can have one for nothing.\", \"给小哥儿买个玩意儿？赢我一局，白送一个。\", \"079b505520c3\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"A deal's a deal. Here, little one.\", \"说话算话。拿去罢，小哥儿。\", \"7bafd9cd308b\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"The back gate's just there.\", \"后门就在那儿。\", \"3f2fd45f5b50\"]]"}]},{"id":222,"name":"back-child","type":"npc","x":984.0,"y":94.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.child"},{"name":"sprite","type":"string","value":"f_child"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"back-child"},{"name":"until","type":"string","value":"31-g3"},{"name":"when","type":"string","value":"node:g2"},{"name":"view","type":"string","value":"4"},{"name":"intro","type":"string","value":"[[\"n\", \"Granny! Granny! Play me! I always win!\", \"老奶奶！老奶奶！跟我下！我回回赢！\", \"8ecb990fa9e0\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"You cheated! No you didn't. Again tomorrow!\", \"你耍赖！……没有就没有。明儿再来！\", \"50724e321fcb\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"Which Zhou Da-niang do you want?\", \"你找哪个周大娘？\", \"f2645f1b5b39\"]]"}]},{"id":223,"name":"exit-the-village","type":"exit","x":0,"y":768,"width":16,"height":64,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"the-village"},{"name":"side","type":"string","value":"W"}]},{"id":224,"name":"exit-the-rong-mansion","type":"exit","x":720,"y":176,"width":32,"height":16,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"the-rong-mansion"},{"name"