":true,"point":true,"properties":[{"name":"node","type":"string","value":"12-a6"},{"name":"label","type":"string","value":"The red lanterns on the avenue"},{"name":"label_zh","type":"string","value":"大街上的红灯"}]},{"id":205,"name":"lubu","type":"spot","x":256,"y":427.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"12-a3"},{"name":"label","type":"string","value":"Lü Bu's quarters"},{"name":"label_zh","type":"string","value":"吕布府"}]},{"id":206,"name":"market","type":"spot","x":328.0,"y":187.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"12-a15"},{"name":"label","type":"string","value":"The market crossroads"},{"name":"label_zh","type":"string","value":"市中十字路口"}]},{"id":207,"name":"shisun","type":"spot","x":480,"y":251.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"12-a12a"},{"name":"label","type":"string","value":"Shisun Rui's house"},{"name":"label_zh","type":"string","value":"士孙瑞宅"}]},{"id":208,"name":"huangwan","type":"spot","x":96,"y":171.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"12-a12b"},{"name":"label","type":"string","value":"Huang Wan's house"},{"name":"label_zh","type":"string","value":"黄琬宅"}]},{"id":209,"name":"north-gate","type":"spot","x":496,"y":107.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"12-a14"},{"name":"label","type":"string","value":"The North Side Gate"},{"name":"label_zh","type":"string","value":"北掖门"}]},{"id":210,"name":"xuanping","type":"spot","x":432,"y":331.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"12-a18"},{"name":"label","type":"string","value":"The Xuanping Gate"},{"name":"label_zh","type":"string","value":"宣平门"}]},{"id":211,"name":"spot-12-a13d","type":"spot","x":256,"y":235.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"12-a13d"},{"name":"label","type":"string","value":""},{"name":"label_zh","type":"string","value":""}]},{"id":212,"name":"npc-1","type":"npc","x":216.0,"y":190.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.elder"},{"name":"sprite","type":"string","value":"f_elder"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“The master hasn't slept. He walks the garden and sighs.”\", \"“老爷一夜没睡，在园里走来走去，只是叹气。”\", \"a2935347458d\"]]"},{"name":"face","type":"string","value":"down"},{"name":"gives","type":"string","value":"pearls"},{"name":"gives_when","type":"string","value":"node:a2"},{"name":"give","type":"string","value":"[[\"n\", \"The old steward unlocks the family chest. “The pearls your father kept, master. Whatever you need them for, I never saw.”\", \"老管家打开家中宝箱。“这是老太爷留下的明珠，老爷。不管您拿去做什么，老奴什么也没看见。”\", \"7915c6afce6f\"]]"},{"name":"given","type":"string","value":"[[\"n\", \"“The chest is locked again, master. No one will know.”\", \"“箱子又锁好了，老爷。没人会知道。”\", \"6ec791821427\"]]"}]},{"id":213,"name":"npc-2","type":"npc","x":248.0,"y":190.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.noble"},{"name":"sprite","type":"string","value":"f_noble"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Pearls like these, Minister? Set in gold, they'd crown a general.”\", \"“这样的珠子，司徒？嵌在金上，够给一位将军做冠了。”\", \"e73bac6f62eb\"]]"},{"name":"face","type":"string","value":"down"},{"name":"gives","type":"string","value":"crown"},{"name":"gives_when","type":"string","value":"item:pearls"},{"name":"give","type":"string","value":"[[\"n\", \"“Pearls from your own house, Minister? Then the crown will be the best thing I ever made.”\", \"“是司徒府上自家的珠子？那这顶冠，便是我一生最好的手艺。”\", \"ef93e8f4ed64\"]]"},{"name":"given","type":"string","value":"[[\"n\", \"“That crown was the best work of my life. I hope it went to someone worth it.”\", \"“那顶冠是我平生最好的活计。但愿戴它的人配得上。”\", \"2330990397ed\"]]"}]},{"id":214,"name":"npc-3","type":"npc","x":296.0,"y":446.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.official"},{"name":"sprite","type":"string","value":"f_official"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"runner"},{"name":"until","type":"string","value":"12-a3"},{"name":"face","type":"string","value":"left"},{"name":"when","type":"string","value":"node:a2"},{"name":"intro","type":"string","value":"[[\"n\", \"A runner in the Chancellor's colours steps into your path. “Minister Wang, out on foot? The Grand Preceptor likes to know who walks where.”\", \"一个穿相府号衣的差役拦在你面前。“王司徒，走着出门？太师喜欢知道谁在哪儿走动。”\", \"d4d09f0fc91f\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“Nothing worth reporting, then. Good day, Minister.”\", \"“那就没什么可报的了。司徒慢走。”\", \"955e8adbd57e\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"The runner watches you pass, and says nothing.\", \"差役看着你走过，一言不发。\", \"f431758820b3\"]]"}]},{"id":215,"name":"npc-4","type":"npc","x":312.0,"y":158.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"flyingbear"},{"name":"until","type":"string","value":"12-a3"},{"name":"when","type":"string","value":"node:a2"},{"name":"intro","type":"string","value":"[[\"n\", \"A Flying Bear soldier lounges against the wall, dice in his fist. “Bored, old man? Play me. Lose, and you buy the wine.”\", \"一个飞熊军士倚着墙，手里攥着骰子。“闲得慌吧，老头儿？跟我下一局。输了，你请酒。”\", \"395594b1738b\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“Hah! The old man bites. Go on.”\", \"“哈！老头儿还挺厉害。走吧。”\", \"c29b93dd8e5d\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"“Not again, old man. My purse can't take it.”\", \"“不来了，老头儿。我的钱袋受不住。”\", \"43e446bb5fbd\"]]"}]},{"id":216,"name":"npc-5","type":"npc","x":72.0,"y":174.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"patrol"},{"name":"until","type":"string","value":"12-a12b"},{"name":"face","type":"string","value":"down"},{"name":"when","type":"string","value":"node:a11"},{"name":"intro","type":"string","value":"[[\"n\", \"A Flying Bear patrol fills the lane to Huang Wan's gate. “Visiting late, Minister? Every lane in Chang'an answers to the Grand Preceptor.”\", \"一队飞熊军堵住了通往黄琬家门的巷子。“司徒这么晚还去拜访？长安每条巷子都归太师管。”\", \"477f80309ca2\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“On your way, then. Quickly.”\", \"“那就快走吧。快些。”\", \"bc4097abce6a\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"The patrol has moved on to the next lane.\", \"巡兵已去了下一条巷子。\", \"2af89d903fb8\"]]"}]},{"id":217,"name":"npc-6","type":"npc","x":520.0,"y":222.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_youth"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"informer"},{"name":"until","type":"string","value":"12-a12a"},{"name":"when","type":"string","value":"node:a11"},{"name":"intro","type":"string","value":"[[\"n\", \"A man in a plain coat has sat by Shisun Rui's gate all morning. “A game while you wait, Minister? I have time. I have nothing but time.”\", \"一个穿素袍的人在士孙瑞门口坐了一上午。“司徒，等人的时候下一局？我有的是工夫。我除了工夫什么也没有。”\", \"566c99713730\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“You play like a man with nothing to hide.”\", \"“司徒下棋，像是心里没藏事的人。”\", \"37645c749b7f\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"The man in the plain coat has gone.\", \"穿素袍的人已经走了。\", \"b3b0e3f87e52\"]]"}]},{"id":218,"name":"npc-7","type":"npc","x":312.0,"y":94.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.elder"},{"name":"sprite","type":"string","value":"f_elder2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"scholar"},{"name":"until","type":"string","value":"12-a17"},{"name":"intro","type":"string","value":"[[\"n\", \"“Sit, Minister. In this city it's safer to talk about stones than people.”\", \"“请坐，司徒。这城里，谈棋子比谈人安稳。”\", \"970a76bed814\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“Ha. You read the board the way you read a room.”\", \"“哈。司徒看棋，就像看人一样准。”\", \"fbf2a716e499\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"“Another day, Minister. The stones keep.”\", \"“改日吧，司徒。棋子跑不了。”\", \"34b48d91267d\"]]"}]},{"id":219,"name":"npc-8","type":"npc","x":280.0,"y":270.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"officer"},{"name":"until","type":"string","value":"12-a6"},{"name":"when","type":"string","value":"node:a5"},{"name":"intro","type":"string","value":"[[\"n\", \"A Liangzhou officer steps out of a dark lane. “Out after the drum, Minister? Play me for your way home.”\", \"一名凉州军官从暗巷中闪出。“司徒，鼓都打过了还出门？跟我下一局，赢了就放你回家。”\", \"274e18f116fb\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“Go on, then. I never saw you.”\", \"“走吧。我没见过你。”\", \"ac5b2ccdb9af\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"“Still out, Minister?”\", \"“司徒还在外头？”\", \"c80170e64d26\"]]"}]},{"id":220,"name":"npc-9","type":"npc","x":360.0,"y":158.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Keep to the side lanes. The middle of the avenue is the Son of Heaven's. And the Grand Preceptor's.”\", \"“走小巷吧。大街正中是天子走的。也是太师走的。”\", \"70d7348f67bf\"]]"},{"name":"until","type":"string","value":"12-a14"}]},{"id":221,"name":"npc-10","type":"npc","x":360.0,"y":222.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_farmer"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Two hundred and fifty thousand of us built Meiwu. Walls as high as these. Twenty years of grain inside, they say.”\", \"“二十五万人筑的郿坞。城墙跟这儿一样高。听说里头屯了二十年的粮。”\", \"bd79bf0803ac\"]]"},{"name":"until","type":"string","value":"12-a14"}]},{"id":222,"name":"npc-11","type":"npc","x":248.0,"y":174.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.woman"},{"name":"sprite","type":"string","value":"folk.woman#6"},{"name":"wander","type":"bool","value":false},{"name":"say","type":"string","value":"[[\"n\", \"“They drove us west from Luoyang like geese. My house is ash, and here I sell turnips.”\", \"“他们把我们从洛阳赶到西边，像赶鹅一样。我家成了灰，如今在这儿卖萝卜。”\", \"b489e0fa9139\"]]"},{"name":"until","type":"string","value":"12-a14"}]},{"id":223,"name":"npc-12","type":"npc","x":360.0,"y":270.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.official"},{"name":"sprite","type":"string","value":"f_official"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“He laughed, and went on eating. I couldn't hold my chopsticks. I still can't, some days.”\", \"“他笑着，照吃不误。我连筷子都拿不住。到如今，有时还拿不住。”\", \"059c855262d9\"]]"},{"name":"until","type":"string","value":"12-a14"},{"name":"when","type":"string","value":"node:a1"}]},{"id":224,"name":"npc-13","type":"npc","x":296.0,"y":222.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.child"},{"name":"sprite","type":"string","value":"f_child"},{"name":"wander","type":"bool","value":true},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Mother says don't look at the soldiers with the long halberds.”\", \"“娘说，别去看那些拿长戟的兵。”\", \"dcdd6b387bff\"]]"},{"name":"until","type":"string","value":"12-a14"}]},{"id":225,"name":"npc-14","type":"npc","x":248.0,"y":366.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“The Grand Preceptor receives no one today.”\", \"“太师今日不见客。”\", \"d58728352704\"]]"},{"name":"until","type":"string","value":"12-a14"},{"name":"face","type":"string","value":"down"}]},{"id":226,"name":"npc-15","type":"npc","x":296.0,"y":398.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“In Liangzhou we ride before we walk. These Chang'an streets are too narrow for a horse to stretch.”\", \"“在凉州，我们先会骑马后会走路。长安这些街，窄得马都伸不开腿。”\", \"c91dc2332911\"]]"},{"name":"until","type":"string","value":"12-a14"}]},{"id":227,"name":"npc-16","type":"npc","x":168.0,"y":254.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.maiden"},{"name":"sprite","type":"string","value":"f_maiden2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“They say Lady Diaochan went in the covered carriage, straight to the Grand Preceptor's.”\", \"“听说貂蝉小姐坐着毡车，直送进太师府了。”\", \"5b4c53c009d1\"]]"},{"name":"until","type":"string","value":"12-a10"},{"name":"when","type":"string","value":"node:a5"}]},{"id":228,"name":"npc-17","type":"npc","x":392.0,"y":382.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.maiden"},{"name":"sprite","type":"string","value":"f_maiden2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“The Grand Preceptor spent the night with the new girl and hasn't got up.”\", \"“太师昨夜与新人同寝，至今还没起来。”\", \"a3410daa4798\"]]"},{"name":"until","type":"string","value":"12-a8"},{"name":"when","type":"string","value":"node:a6"}]},{"id":229,"name":"npc-18","type":"npc","x":392.0,"y":366.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.woman"},{"name":"sprite","type":"string","value":"folk.woman#2"},{"name":"wander","type":"bool","value":false},{"name":"say","type":"string","value":"[[\"n\", \"“Walk softly near the middle hall. He throws things when he's woken.”\", \"“到中堂附近脚步放轻些。把他吵醒了，他会扔东西。”\", \"cf66db7f00d3\"]]"},{"name":"until","type":"string","value":"12-a10"},{"name":"when","type":"string","value":"node:a6"}]},{"id":230,"name":"npc-19","type":"npc","x":424.0,"y":254.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“General Lü stood on that ridge till the dust was gone. Didn't say a word.”\", \"“吕将军在那冈上站着，直到尘土都散尽了，一句话也没说。”\", \"3ef7ef4f70d1\"]]"},{"name":"until","type":"string","value":"12-a12"},{"name":"when","type":"string","value":"node:a10"}]},{"id":231,"name":"npc-20","type":"npc","x":344.0,"y":158.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_youth"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“The Grand Preceptor's at Meiwu. The streets breathe again.”\", \"“太师去郿坞了。街上总算能喘口气。”\", \"1be7eeaeb5ae\"]]"},{"name":"until","type":"string","value":"12-a13"},{"name":"when","type":"string","value":"node:a10"}]},{"id":232,"name":"npc-21","type":"npc","x":536.0,"y":126.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.official"},{"name":"sprite","type":"string","value":"f_official"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“The Son of Heaven is recovered from his illness! All officials to the Weiyang Hall!”\", \"“天子病体痊愈！百官齐赴未央殿！”\", \"252bd1e27892\"]]"},{"name":"until","type":"string","value":"12-a14"},{"name":"when","type":"string","value":"node:a13c"}]},{"id":233,"name":"npc-22","type":"npc","x":536.0,"y":110.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.official"},{"name":"sprite","type":"string","value":"f_official"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Why are we all wearing swords to a celebration?”\", \"“庆贺的日子，怎么人人都带着剑？”\", \"499732321c83\"]]"},{"name":"until","type":"string","value":"12-a14"},{"name":"when","type":"string","value":"node:a13c"}]},{"id":234,"name":"npc-23","type":"npc","x":296.0,"y":206.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_farmer2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Sell the coat! Buy wine! The old traitor is dead!”\", \"“卖了衣裳！打酒去！老贼死了！”\", \"9cfadf697890\"]]"},{"name":"until","type":"string","value":"12-a16"},{"name":"when","type":"string","value":"node:a14"}]},{"id":235,"name":"npc-24","type":"npc","x":360.0,"y":206.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_porter"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“That one's for my brother, who died on the road from Luoyang.”\", \"“这一脚，替我兄弟踢的。他死在洛阳西迁的路上。”\", \"d004c16fd6bb\"]]"},{"name":"until","type":"string","value":"12-a16"},{"name":"when","type":"string","value":"node:a14"}]},{"id":236,"name":"npc-25","type":"npc","x":376.0,"y":142.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.child"},{"name":"sprite","type":"string","value":"f_child"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Ten thousand years! Ten thousand years!”\", \"“万岁！万岁！”\", \"b1c5858c02fd\"]]"},{"name":"until","type":"string","value":"12-a16"},{"name":"when","type":"string","value":"node:a14"}]},{"id":237,"name":"npc-26","type":"npc","x":248.0,"y":158.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.official"},{"name":"sprite","type":"string","value":"f_official"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“I held a cup today. My hand didn't shake once.”\", \"“今天我端了一杯酒。手一下也没抖。”\", \"cd87ef283f71\"]]"},{"name":"until","type":"string","value":"12-a16"},{"name":"when","type":"string","value":"node:a14"}]},{"id":238,"name":"npc-27","type":"npc","x":360.0,"y":142.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_farmer"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“The Liangzhou men are inside! Li Meng and Wang Fang opened the gates!”\", \"“凉州兵进城了！李蒙、王方开了城门！”\", \"d5de6fc1af44\"]]"},{"name":"when","type":"string","value":"node:a17"}]},{"id":239,"name":"npc-28","type":"npc","x":472.0,"y":334.4,"width":0,"height":0,"rotation"