e":16},{"name":"fh","type":"int","value":16},{"name":"solid","type":"bool","value":false}]},{"id":212,"name":"wheel","type":"spot","x":448,"y":203.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"12-a13a"},{"name":"label","type":"string","value":"The rutted bend"},{"name":"label_zh","type":"string","value":"车辙纵横的弯路"}]},{"id":213,"name":"fog","type":"spot","x":392.0,"y":219.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"12-a13b"},{"name":"label","type":"string","value":"The open plain"},{"name":"label_zh","type":"string","value":"空旷的原野"}]},{"id":214,"name":"fields","type":"spot","x":336,"y":203.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"12-a13c"},{"name":"label","type":"string","value":"The night camp outside the walls"},{"name":"label_zh","type":"string","value":"城外夜营"}]},{"id":215,"name":"taoist","type":"spot","x":544,"y":219.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"12-a13d"},{"name":"label","type":"string","value":"The roadside before the city"},{"name":"label_zh","type":"string","value":"入城前的路边"}]},{"id":216,"name":"npc-1","type":"npc","x":360.0,"y":238.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"roadpatrol"},{"name":"until","type":"string","value":"12-a13"},{"name":"face","type":"string","value":"left"},{"name":"when","type":"string","value":"node:a12"},{"name":"view","type":"string","value":"7"},{"name":"guard_x","type":"float","value":696.0},{"name":"guard_y","type":"float","value":168.0},{"name":"intro","type":"string","value":"[[\"n\", \"A patrol of the Grand Preceptor's horsemen bars the road. “Rider from Chang'an! Halt, and show us what you carry.”\", \"一队太师的骑兵拦住了路。“长安来的骑者！站住，把你带的东西拿出来！”\", \"adfb168e4bad\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“An edict for the Grand Preceptor? Ride on, then, and ride fast.”\", \"“给太师的诏书？那快走吧，快马加鞭。”\", \"55bd07af2ef4\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"The patrol waves you through.\", \"巡骑挥手让你过去。\", \"b0f1c06e4a37\"]]"}]},{"id":217,"name":"npc-2","type":"npc","x":296.0,"y":206.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.elder"},{"name":"sprite","type":"string","value":"f_elder"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Thirty li to the next post, sir. Mind the ruts after the bridge.”\", \"“离下一个驿亭还有三十里，大人。过了桥小心车辙。”\", \"3697e2f4fc61\"]]"},{"name":"challenge","type":"string","value":"postkeeper"},{"name":"until","type":"string","value":"12-a13"},{"name":"when","type":"string","value":"node:a12"},{"name":"view","type":"string","value":"3"},{"name":"intro","type":"string","value":"[[\"n\", \"The post keeper has a board out on the bench. “Long nights out here. Sit a moment, sir.”\", \"亭长在长凳上摆着一副棋。“这里的夜长得很。坐一会儿吧，大人。”\", \"d3589f96f476\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“The road's yours. Mind the ruts.”\", \"“路是你的了。小心车辙。”\", \"eff2534dcc0a\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"“Safe road, sir.”\", \"“一路平安，大人。”\", \"15611ae46e6e\"]]"}]},{"id":218,"name":"npc-3","type":"npc","x":232.0,"y":222.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_porter"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“We built Meiwu, and they sent us home with nothing but a sore back.”\", \"“郿坞是我们筑的，打发我们回家时，只落得一身腰疼。”\", \"d8e3888e82c6\"]]"},{"name":"until","type":"string","value":"12-a13"},{"name":"when","type":"string","value":"node:a12"}]},{"id":219,"name":"npc-4","type":"npc","x":424.0,"y":222.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_farmer2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Heads down, heads down. Don't let him see your face.”\", \"“低头，低头。别让他看见你的脸。”\", \"601c9a72215d\"]]"},{"name":"until","type":"string","value":"12-a13c"},{"name":"face","type":"string","value":"down"},{"name":"when","type":"string","value":"node:a13"}]},{"id":220,"name":"npc-5","type":"npc","x":424.0,"y":206.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“A new carriage by noon. The Grand Preceptor says it's a sign: the new for the old.”\", \"“午时就换新车。太师说这是吉兆：弃旧换新。”\", \"4e6b6fd195fd\"]]"},{"name":"until","type":"string","value":"12-a13c"},{"name":"when","type":"string","value":"node:a13a"}]},{"id":221,"name":"npc-6","type":"npc","x":392.0,"y":238.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“I can't see the horse in front of me. Where's the carriage?”\", \"“我连前头的马都看不见。车在哪儿？”\", \"9d9232259724\"]]"},{"name":"until","type":"string","value":"12-a13b"},{"name":"when","type":"string","value":"node:a13a"}]},{"id":222,"name":"npc-7","type":"npc","x":344.0,"y":238.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_youth"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Children in the fields at this hour? Whose children?”\", \"“这时辰，田里还有孩子？谁家的孩子？”\", \"c58da078f928\"]]"},{"name":"until","type":"string","value":"12-a13c"},{"name":"when","type":"string","value":"node:a13b"}]},{"id":223,"name":"exit-meiwu","type":"exit","x":720,"y":144,"width":16,"height":32,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"meiwu"},{"name":"side","type":"string","value":"E"}]},{"id":224,"name":"exit-changan","type":"exit","x":0,"y":192,"width":16,"height":32,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"changan"},{"name":"side","type":"string","value":"W"}]},{"id":225,"name":"exit-meiwu-road--post","type":"exit","x":257.6,"y":173.6,"width":12.8,"height":7.2,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"meiwu-road--post"},{"name":"side","type":"string","value":"N"}]},{"id":226,"name":"entry-meiwu","type":"entry","x":696.0,"y":174.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"from","type":"string","value":"meiwu"}]},{"id":227,"name":"entry-changan","type":"entry","x":40.0,"y":222.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"from","type":"string","value":"changan"}]},{"id":228,"name":"entry","type":"entry","x":40.0,"y":222.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true},{"id":229,"name":"entry-meiwu-road--post","type":"e