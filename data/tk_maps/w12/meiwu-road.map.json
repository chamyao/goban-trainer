   "kind": "folk.elder",
   "x": 18.5,
   "y": 12.9,
   "say": [
    "“Thirty li to the next post, sir. Mind the ruts after the bridge.”"
   ],
   "challenge": "postkeeper",
   "intro": [
    "The post keeper has a board out on the bench. “Long nights out here. Sit a moment, sir.”"
   ],
   "win": [
    "“The road's yours. Mind the ruts.”"
   ],
   "done": [
    "“Safe road, sir.”"
   ],
   "until": "12-a13",
   "when": "node:a12",
   "view": 3
  },
  {
   "id": "npc-3",
   "kind": "folk.villager",
   "x": 14.5,
   "y": 13.9,
   "say": [
    "“We built Meiwu, and they sent us home with nothing but a sore back.”"
   ],
   "until": "12-a13",
   "when": "node:a12"
  },
  {
   "id": "npc-4",
   "kind": "folk.villager",
   "x": 26.5,
   "y": 13.9,
   "say": [
