   "id": "npc-5",
   "kind": "folk.soldier",
   "x": 26.5,
   "y": 12.9,
   "say": [
    "“A new carriage by noon. The Grand Preceptor says it's a sign: the new for the old.”"
   ],
   "until": "12-a13c",
   "when": "node:a13a"
  },
