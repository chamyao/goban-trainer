 "npcs": [
  {
   "id": "npc-1",
   "kind": "folk.elder",
   "x": 22.5,
   "y": 10.9,
   "say": [],
   "challenge": "headman",
   "intro": [
    "A headman sits on a stone by the road, a stick across his knees. “You're spreading tales from Chang'an. Convince me first.”"
   ],
   "win": [
    "“…Then it's true. I'll tell the others myself.”"
   ],
   "done": [
    "“I've told them. They're coming.”"
   ],
   "until": "12-a16b",
   "when": "node:a16a"
  },
  {
   "id": "npc-2",
   "kind": "folk.official",
   "x": 24.5,
   "y": 18.9,
   "say": [],
   "challenge": "constable",
   "intro": [
    "The constable stands at the pavilion, arms folded. “A man without an army is just a man on a road. I've tied up better.”"
   ],
   "win": [
    "“…That's no road gang behind you. That's Liangzhou.”"
   ],
   "done": [
    "The constable has taken down his rope."
   ],
   "until": "12-a16c",
   "face": "left",
   "when": "node:a16b"
  },
  {
   "id": "npc-3",
   "kind": "folk.soldier",
   "x": 31.5,
   "y": 15.9,
   "say": [],
   "challenge": "scout",
   "intro": [
    "A scout calls down from his post on the hill. “General! Lü Bu's dust on the east road. Want to know how many?”"
   ],
   "win": [
    "“Then you know as well as I do. Ready the gongs and drums.”"
   ],
   "done": [
    "The scout watches the east road."
   ],
   "until": "12-a17",
   "when": "node:a16m"
  },
  {
   "id": "npc-4",
   "kind": "folk.soldier",
   "x": 11.5,
   "y": 13.9,
   "say": [
    "“No pardon. The envoy came back with nothing. I'm going home to my mother.”"
   ],
   "until": "12-a16"
  },
  {
   "id": "npc-5",
   "kind": "folk.elder",
   "x": 22.5,
   "y": 9.9,
   "say": [
    "“Wang Yun? A man of the east. What does he know of Liangzhou?”"
   ],
   "until": "12-a16a"
  },
  {
   "id": "npc-6",
   "kind": "folk.elder",
   "x": 22.5,
   "y": 13.9,
   "say": [
    "“Then we're dead men either way. Better on horseback.”"
   ],
   "when": "node:a16a"
  },
  {
   "id": "npc-7",
   "kind": "folk.woman",
   "x": 18.5,
   "y": 11.9,
   "say": [
    "“We have a wall. Walls kept out the Qiang. Will they keep out Chang'an?”"
   ]
  },
  {
   "id": "npc-8",
   "kind": "folk.soldier",
   "x": 19.5,
   "y": 14.9,
   "say": [
    "“Better die marching than in our beds.”"
   ],
   "when": "node:a16c"
  }
 ],
