 "npcs": [
  {
   "id": "npc-1",
   "kind": "folk.soldier",
   "x": 27.5,
   "y": 16.9,
   "say": [],
   "challenge": "gateguard",
   "intro": [
    "The gate captain turns the edict over in his hands. “Seals can be made in Chang'an. Prove you're who you say.”"
   ],
   "win": [
    "“Pass, Commandant Li. Open the gate!”"
   ],
   "done": [
    "The gate stands open for you."
   ],
   "until": "12-a13",
   "face": "down",
   "when": "node:a12"
  },
  {
   "id": "npc-2",
   "kind": "folk.soldier",
   "x": 24.5,
   "y": 13.9,
   "say": [],
   "challenge": "straggler",
   "intro": [
    "One of Dong Zhuo's guards still holds the treasury door, spear levelled. “The Grand Preceptor's gold! Nobody touches it!”"
   ],
   "win": [
    "“…He's dead, isn't he. Take it. Take all of it.”"
   ],
   "done": [
    "The guard has thrown down his spear."
   ],
   "until": "12-a15m",
   "face": "down",
   "when": "node:a15"
  },
  {
   "id": "npc-3",
   "kind": "folk.soldier",
   "x": 12.5,
   "y": 18.9,
   "say": [],
   "challenge": "bearofficer",
   "intro": [
    "A Flying Bear officer crouches in a side court, sword half drawn. “General Lü. I always wondered which of us was better.”"
   ],
   "win": [
    "“So now I know.”"
   ],
   "done": [
    "The officer sits against the wall and does not look up."
   ],
   "until": "12-a15m",
   "when": "node:a15"
  },
  {
   "id": "npc-4",
   "kind": "folk.soldier",
   "x": 31.5,
   "y": 15.9,
   "say": [
    "“Walls as thick as Chang'an's. Nothing comes through this gate he doesn't want.”"
   ],
   "until": "12-a14"
  },
  {
   "id": "npc-5",
   "kind": "folk.elder",
   "x": 20.5,
   "y": 17.9,
   "say": [
    "“Twenty years of grain. ‘If I succeed I hold the empire,’ he says, ‘and if not, I grow old here.’”"
   ],
   "until": "12-a14"
  },
  {
   "id": "npc-6",
   "kind": "folk.maiden",
   "x": 17.5,
   "y": 18.9,
   "say": [
    "“They took me from my mother's door in Chang'an. Eight hundred of us, picked like peaches.”"
   ],
   "until": "12-a14"
  },
  {
   "id": "npc-7",
   "kind": "folk.woman",
   "x": 12.5,
   "y": 15.9,
   "say": [
    "“The old lady is ninety. She says her flesh trembles. She hasn't slept in days.”"
   ],
   "until": "12-a14"
  },
  {
   "id": "npc-8",
   "kind": "folk.maiden",
   "x": 30.5,
   "y": 18.9,
   "say": [
    "“The gate is open. Which road goes home?”"
   ],
   "when": "node:a15"
  },
  {
   "id": "npc-9",
   "kind": "folk.official",
   "x": 28.5,
   "y": 10.9,
   "say": [
    "“Gold, tens of thousands of jin. Silver, millions. I've stopped counting the silk.”"
   ],
   "when": "node:a15m"
  }
 ],
