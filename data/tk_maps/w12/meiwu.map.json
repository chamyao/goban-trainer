 "npcs": [
  {
   "id": "npc-1",
   "kind": "folk.soldier",
   "x": 33.5,
   "y": 24.9,
   "say": [
    "“Walls as thick as Chang'an's. Nothing comes through this gate he doesn't want.”"
   ],
   "in": [
    "fortress"
   ]
  },
  {
   "id": "npc-2",
   "kind": "folk.elder",
   "x": 9.5,
   "y": 39.9,
   "say": [
    "“Twenty years of grain. ‘If I succeed I hold the empire,’ he says, ‘and if not, I grow old here.’”"
   ],
   "in": [
    "fortress"
   ]
  },
  {
   "id": "npc-3",
   "kind": "folk.maiden",
   "x": 13.5,
   "y": 22.9,
   "say": [
    "“They took me from my mother's door in Chang'an. Eight hundred of us, picked like peaches.”"
   ],
   "in": [
    "fortress"
   ]
  },
  {
   "id": "npc-4",
   "kind": "folk.woman",
   "x": 13.5,
   "y": 14.9,
   "say": [
    "“The old lady is ninety. She says her flesh trembles. She hasn't slept in days.”"
   ],
   "in": [
    "fortress"
   ]
  },
  {
   "id": "npc-5",
   "kind": "folk.maiden",
   "x": 38.5,
   "y": 22.9,
   "say": [
    "“The gate is open. Which road goes home?”"
   ],
   "in": [
    "raided"
   ]
  },
  {
   "id": "npc-6",
   "kind": "folk.official",
   "x": 33.5,
   "y": 31.9,
   "say": [
    "“Gold, tens of thousands of jin. Silver, millions. I've stopped counting the silk.”"
   ],
   "in": [
    "raided"
   ]
  },
  {
   "id": "npc-7",
   "kind": "hero.huangfusong",
   "x": 25.5,
   "y": 33.9,
   "say": [
    "“Let them out. All of them. Give each a little silver for the road.”"
   ],
   "in": [
    "raided"
   ]
  },
  {
