:"given","type":"string","value":"[[\"n\", \"“The chest is locked again, master. No one will know.”\", \"“箱子又锁好了，老爷。没人会知道。”\", \"6ec791821427\"]]"}]},{"id":28,"name":"exit-changan--wy-secret","type":"exit","x":16,"y":32,"width":16,"height":32,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"changan--wy-secret"},{"name":"side","type":"string","value":"W"}]},{"id":29,"name":"exit-changan--wangyun","type":"exit","x":192,"y":192,"width":32,"height":16,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"changan--wangyun"},{"name":"side","type":"string","value":"S"}]},{"id":30,"name":"entry-changan--wy-secret","type":"entry","x":24.0,"y":62.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"from","type":"string","value":"changan--wy-secret"}]},{"id":31,"name":"entry-changan--wangyun","type":"entry","x":200.0,"y":206.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"from","type":"string","value":"changan--wangyun"}]},{"id":32,"name":"entry","type":"entry","x":200.0,"y":206.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true}]}]}