,{"name":"label","type":"string","value":"Wind and fog"},{"name":"label_zh","type":"string","value":"狂风昏雾"},{"name":"trigger","type":"string","value":"near"}]},{"id":114,"name":"fields","type":"spot","x":2136.0,"y":475.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"12-a13c"},{"name":"label","type":"string","value":"Children singing in the fields"},{"name":"label_zh","type":"string","value":"田间唱歌的孩子"},{"name":"trigger","type":"string","value":"near"}]},{"id":115,"name":"npc-1","type":"npc","x":920.0,"y":350.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_porter"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“We built it, and they sent us home with nothing but a sore back.”\", \"“城是我们筑的，打发我们回家时，只落得一身腰疼。”\", \"f312eb25bae9\"]]"},{"name":"in","type":"string","value":"[\"ride-out\"]"}]},{"id":116,"name":"npc-2","type":"npc","x":920.0,"y":414.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_farmer"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Heads down, heads down. Don't let him see your face.”\", \"“低头，低头。别让他看见你的脸。”\", \"601c9a72215d\"]]"},{"name":"face","type":"string","value":"down"},{"name":"in","type":"string","value":"[\"procession\"]"}]},{"id":117,"name":"npc-3","type":"npc","x":664.0,"y":350.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“A new carriage by noon. The Grand Preceptor says it's a sign: the new for the old.”\", \"“午时就换新车。太师说这是吉兆：弃旧换新。”\", \"4e6b6fd195fd\"]]"},{"name":"when","type":"string","value":"node:a13a"},{"name":"in","type":"string","value":"[\"procession\"]"}]},{"id":118,"name":"npc-4","type":"npc","x":1240.0,"y":286.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“I can't see the horse in front of me. Where's the carriage?”\", \"“我连前头的马都看不见。车在哪儿？”\", \"9d9232259724\"]]"},{"name":"in","type":"string","value":"[\"fog\"]"}]},{"id":119,"name":"npc-5","type":"npc","x":1848.0,"y":382.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_youth"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Children in the fields at this hour? Whose children?”\", \"“这时辰，田里还有孩子？谁家的孩子？”\", \"c58da078f928\"]]"},{"name":"in","type":"string","value":"[\"night\"]"}]},{"id":120,"name":"npc-6","type":"npc","x":1976.0,"y":318.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"hero.lubu"},{"name":"sprite","type":"string","value":"lubu"},{"name":"wander","type":"bool","value":false},{"name":"say","type":"string","value":"[[\"n\", \"Lü Bu sleeps outside the Grand Preceptor's tent, his halberd across his knees.\", \"吕布睡在太师帐前，画戟横在膝上。\", \"add59fc65874\"]]"},{"name":"in","type":"string","value":"[\"night\"]"}]},{"id":121,"name":"roadpatrol","type":"npc","x":536.0,"y":286.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"roadpatrol"},{"name":"until","type":"string","value":"12-a13"},{"name":"when","type":"string","value":"node:a12"},{"name":"view","type":"string","value":"12"},{"name":"guard_x","type":"float","value":480.0},{"name":"guard_y","type":"float","value":288.0},{"name":"intro","type":"string","value":"[[\"n\", \"A patrol of the Grand Preceptor's horsemen bars the road. “Rider from Chang'an! Halt, and show us what you carry.”\", \"一队太师的骑兵拦住了路。“长安来的骑者！站住，把你带的东西拿出来！”\", \"adfb168e4bad\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“An edict for the Grand Preceptor? Ride on, then, and ride fast.”\", \"“给太师的诏书？那快走吧，快马加鞭。”\", \"55bd07af2ef4\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"The patrol waves you through.\", \"巡骑挥手让你过去。\", \"b0f1c06e4a37\"]]"}]},{"id":122,"name":"postkeeper","type":"npc","x":792.0,"y":350.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.elder"},{"name":"sprite","type":"string","value":"f_elder2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"postkeeper"},{"name":"until","type":"string","value":"12-a13"},{"name":"when","type":"string","value":"node:a12"},{"name":"view","type":"string","value":"4"},{"name":"intro","type":"string","value":"[[\"n\", \"The post keeper has a board out on the bench. “Long nights out here. Sit a moment, sir.”\", \"亭长在长凳上摆着一副棋。“这里的夜长得很。坐一会儿吧，大人。”\", \"d3589f96f476\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“The road's yours. Mind the ruts after the bridge.”\", \"“路是你的了。过了桥小心车辙。”\", \"7f0217b7524c\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"“Safe road, sir.”\", \"“一路平安，大人。”\", \"15611ae46e6e\"]]"}]},{"id":123,"name":"exit-meiwu","type":"exit","x":0,"y":256,"width":16,"height":64,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"meiwu"},{"name":"side","type":"string","value":"W"}]},{"id":124,"name":"exit-changan","type":"exit","x":2288,"y":192,"width":16,"height":64,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"changan"},{"name":"side","type":"string","value":"E"}]},{"id":125,"name":"entry-meiwu","type":"entry","x":88.0,"y":286.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"from","type":"string","value":"meiwu"}]},{"id":126,"name":"entry-changan","type":"entry","x":2200.0,"y":222.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"from","type":"string","value":"changan"}]},{"id":127,"name":"entry","type":"entry","x":2200.0,"y":222.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true}]}]}