,"type":"bool","value":true}]},{"id":229,"name":"tree.small#0","type":"prop","x":536.0,"y":256,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"tree.small"},{"name":"fw","type":"int","value":16},{"name":"fh","type":"int","value":16},{"name":"solid","type":"bool","value":true}]},{"id":230,"name":"lamp.post#0","type":"prop","x":184.0,"y":80,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"lamp.post"},{"name":"fw","type":"int","value":16},{"name":"fh","type":"int","value":16},{"name":"solid","type":"bool","value":true}]},{"id":231,"name":"npc-1","type":"npc","x":440.0,"y":302.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"gateguard"},{"name":"until","type":"string","value":"12-a13"},{"name":"face","type":"string","value":"down"},{"name":"when","type":"string","value":"node:a12"},{"name":"intro","type":"string","value":"[[\"n\", \"The gate captain turns the edict over in his hands. “Seals can be made in Chang'an. Prove you're who you say.”\", \"守门的队长把诏书翻来覆去地看。“印信长安也刻得出来。证明你是你说的那个人。”\", \"d4fce9c03b72\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“Pass, Commandant Li. Open the gate!”\", \"“李都尉请进。开门！”\", \"6d6e90f9082c\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"The gate stands open for you.\", \"坞门为你敞开着。\", \"129ab2ca1a44\"]]"}]},{"id":232,"name":"npc-2","type":"npc","x":328.0,"y":206.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"straggler"},{"name":"until","type":"string","value":"12-a15m"},{"name":"face","type":"string","value":"down"},{"name":"when","type":"string","value":"node:a15"},{"name":"intro","type":"string","value":"[[\"n\", \"One of Dong Zhuo's guards still holds the treasury door, spear levelled. “The Grand Preceptor's gold! Nobody touches it!”\", \"一个董卓的卫兵仍守着库房门，长枪平举。“太师的金子！谁也不许碰！”\", \"c86f58ac77e0\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“…He's dead, isn't he. Take it. Take all of it.”\", \"“……他死了，是不是。拿去吧。全拿去吧。”\", \"83bc590f858a\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"The guard has thrown down his spear.\", \"卫兵扔下了长枪。\", \"52092a9c3c1a\"]]"}]},{"id":233,"name":"npc-3","type":"npc","x":264.0,"y":318.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"bearofficer"},{"name":"until","type":"string","value":"12-a15m"},{"name":"when","type":"string","value":"node:a15"},{"name":"intro","type":"string","value":"[[\"n\", \"A Flying Bear officer crouches in a side court, sword half drawn. “General Lü. I always wondered which of us was better.”\", \"一名飞熊军官伏在侧院，刀已半出鞘。“吕将军。我一直想知道，咱俩谁更厉害。”\", \"3f2a17d53319\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“So now I know.”\", \"“这下知道了。”\", \"4a643cd0cc13\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"The officer sits against the wall and does not look up.\", \"军官靠墙坐着，头也不抬。\", \"1045b0949b80\"]]"}]},{"id":234,"name":"npc-4","type":"npc","x":504.0,"y":302.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Walls as thick as Chang'an's. Nothing comes through this gate he doesn't want.”\", \"“城墙跟长安一样厚。他不想放进来的，什么也进不了这道门。”\", \"3c1358df5d70\"]]"},{"name":"until","type":"string","value":"12-a14"}]},{"id":235,"name":"npc-5","type":"npc","x":424.0,"y":254.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.elder"},{"name":"sprite","type":"string","value":"f_elder2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Twenty years of grain. ‘If I succeed I hold the empire,’ he says, ‘and if not, I grow old here.’”\", \"“二十年的粮。他说：‘事成，雄踞天下；不成，守此足以终老。’”\", \"f164185ccaa0\"]]"},{"name":"until","type":"string","value":"12-a14"}]},{"id":236,"name":"npc-6","type":"npc","x":248.0,"y":318.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.maiden"},{"name":"sprite","type":"string","value":"f_maiden2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“They took me from my mother's door in Chang'an. Eight hundred of us, picked like peaches.”\", \"“他们在长安我娘的门口把我带走。我们八百人，像摘桃子一样挑来的。”\", \"9068349d1bdc\"]]"},{"name":"until","type":"string","value":"12-a14"}]},{"id":237,"name":"npc-8","type":"npc","x":472.0,"y":302.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.maiden"},{"name":"sprite","type":"string","value":"f_maiden"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“The gate is open. Which road goes home?”\", \"“门开了。哪条路回家？”\", \"8ca8833f5bd5\"]]"},{"name":"when","type":"string","value":"node:a15"}]},{"id":238,"name":"npc-9","type":"npc","x":328.0,"y":190.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.official"},{"name":"sprite","type":"string","value":"f_official"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Gold, tens of thousands of jin. Silver, millions. I've stopped counting the silk.”\", \"“黄金几万斤，白银几百万。绸缎我已经不数了。”\", \"c6be4f9b5148\"]]"},{"name":"when","type":"string","value":"node:a15m"}]},{"id":239,"name":"exit-changan","type":"exit","x":0,"y":192,"width":16,"height":32,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"changan"},{"name":"side","type":"string","value":"W"}]},{"id":240,"name":"exit-meiwu-road","type":"exit","x":0,"y":304,"width":16,"height":32,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"meiwu-road"},{"name":"side","type":"string","value":"W"}]},{"id":241,"name":"exit-meiwu--hall","type":"exit","x":233.6,"y":269.6,"width":12.8,"height":7.2,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"meiwu--hall"},{"name":"side","type":"string","value":"N"}]},{"id":242,"name":"exit-meiwu--treasury","type":"exit","x":281.6,"y":157.6,"width":12.8,"height":7.2,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"meiwu--treasury"},{"name":"side","type":"string","value":"N"}]},{"id":243,"name":"exit-meiwu--house-1","type":"exit","x":105.6,"y":269.6,"width":12.8,"height":7.2,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"meiwu--house-1"},{"name":"side","type":"string","value":"N"}]},{"id":244,"name":"exit-meiwu--house-2","type":"exit","x":377.6,"y":157.6,"width":12.8,"height":7.2,"rotation":0,"visible":true,"pr