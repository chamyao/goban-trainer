0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"wall"},{"name":"fw","type":"int","value":368},{"name":"fh","type":"int","value":16},{"name":"solid","type":"bool","value":true}]},{"id":103,"name":"","type":"prop","x":664.0,"y":688,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"wall"},{"name":"fw","type":"int","value":304},{"name":"fh","type":"int","value":16},{"name":"solid","type":"bool","value":true}]},{"id":104,"name":"gate","type":"spot","x":472.0,"y":731.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":""},{"name":"label","type":"string","value":"The gate of Meiwu"},{"name":"label_zh","type":"string","value":"郿坞坞门"}]},{"id":105,"name":"npc-1","type":"npc","x":536.0,"y":398.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Walls as thick as Chang'an's. Nothing comes through this gate he doesn't want.”\", \"“城墙跟长安一样厚。他不想放进来的，什么也进不了这道门。”\", \"3c1358df5d70\"]]"},{"name":"in","type":"string","value":"[\"fortress\"]"}]},{"id":106,"name":"npc-2","type":"npc","x":152.0,"y":638.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.elder"},{"name":"sprite","type":"string","value":"f_elder"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Twenty years of grain. ‘If I succeed I hold the empire,’ he says, ‘and if not, I grow old here.’”\", \"“二十年的粮。他说：‘事成，雄踞天下；不成，守此足以终老。’”\", \"f164185ccaa0\"]]"},{"name":"in","type":"string","value":"[\"fortress\"]"}]},{"id":107,"name":"npc-3","type":"npc","x":168.0,"y":398.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.maiden"},{"name":"sprite","type":"string","value":"f_maiden"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“They took me from my mother's door in Chang'an. Eight hundred of us, picked like peaches.”\", \"“他们在长安我娘的门口把我带走。我们八百人，像摘桃子一样挑来的。”\", \"9068349d1bdc\"]]"},{"name":"in","type":"string","value":"[\"fortress\"]"}]},{"id":108,"name":"npc-4","type":"npc","x":168.0,"y":238.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.woman"},{"name":"sprite","type":"string","value":"folk.woman#5"},{"name":"wander","type":"bool","value":false},{"name":"say","type":"string","value":"[[\"n\", \"“The old lady is ninety. She says her flesh trembles. She hasn't slept in days.”\", \"“老夫人九十了。她说身上肉颤，好几天没合眼了。”\", \"3501f7268306\"]]"},{"name":"in","type":"string","value":"[\"fortress\"]"}]},{"id":109,"name":"npc-5","type":"npc","x":680.0,"y":398.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.maiden"},{"name":"sprite","type":"string","value":"f_maiden2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“The gate is open. Which road goes home?”\", \"“门开了。哪条路回家？”\", \"8ca8833f5bd5\"]]"},{"name":"in","type":"string","value":"[\"raided\"]"}]},{"id":110,"name":"npc-6","type":"npc","x":536.0,"y":510.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.official"},{"name":"sprite","type":"string","value":"f_official"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Gold, tens of thousands of jin. Silver, millions. I've stopped counting the silk.”\", \"“黄金几万斤，白银几百万。绸缎我已经不数了。”\", \"c6be4f9b5148\"]]"},{"name":"in","type":"string","value":"[\"raided\"]"}]},{"id":111,"name":"npc-7","type":"npc","x":408.0,"y":542.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"hero.huangfusong"},{"name":"sprite","type":"string","value":"huangfusong"},{"name":"wander","type":"bool","value":false},{"name":"say","type":"string","value":"[[\"say\", \"huangfusong\", \"Let them out. All of them. Give each a little silver for the road.\", \"放她们出去，一个不留。每人给些盘缠。\", \"0759f5407f95\"]]"},{"name":"in","type":"string","value":"[\"raided\"]"}]},{"id":112,"name":"gateguard","type":"npc","x":488.0,"y":734.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"gateguard"},{"name":"until","type":"string","value":"12-a13"},{"name":"when","type":"string","value":"node:a12"},{"name":"view","type":"string","value":"4"},{"name":"guard_x","type":"float","value":480.0},{"name":"guard_y","type":"float","value":664.0},{"name":"intro","type":"string","value":"[[\"n\", \"The gate captain turns the edict over in his hands. “Seals can be made in Chang'an. Prove you're who you say.”\", \"守门的队长把诏书翻来覆去地看。“印信长安也刻得出来。证明你是你说的那个人。”\", \"d4fce9c03b72\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“Pass, Commandant Li. Open the gate!”\", \"“李都尉请进。开门！”\", \"6d6e90f9082c\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"The gate stands open for you.\", \"坞门为你敞开着。\", \"129ab2ca1a44\"]]"}]},{"id":113,"name":"straggler","type":"npc","x":472.0,"y":478.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"straggler"},{"name":"until","type":"string","value":"12-a15m"},{"name":"when","type":"string","value":"node:a15"},{"name":"view","type":"string","value":"4"},{"name":"guard_x","type":"float","value":480.0},{"name":"guard_y","type":"float","value":416.0},{"name":"intro","type":"string","value":"[[\"n\", \"One of Dong Zhuo's guards still holds the treasury doors, spear levelled. “The Grand Preceptor's gold! Nobody touches it!”\", \"一个董卓的卫兵仍守着库房大门，长枪平举。“太师的金子！谁也不许碰！”\", \"0404a6376d9f\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“…He's dead, isn't he. Take it. Take all of it.”\", \"“……他死了，是不是。拿去吧。全拿去吧。”\", \"83bc590f858a\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"The guard has thrown down his spear.\", \"卫兵扔下了长枪。\", \"52092a9c3c1a\"]]"}]},{"id":114,"name":"bearofficer","type":"npc","x":216.0,"y":542.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"bearofficer"},{"name":"until","type":"string","value":"12-a15m"},{"name":"when","type":"string","value":"node:a15"},{"name":"view","type":"string","value":"4"},{"name":"intro","type":"string","value":"[[\"n\", \"A Flying Bear officer crouches among the granaries, sword half drawn. “General Lü. I always wondered which of us was better.”\", \"一名飞熊军官伏在粮仓之间，刀已半出鞘。“吕将军。我一直想知道，咱俩谁更厉害。”\", \"67fd982de72c\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“So now I know.”\", \"“这下知道了。”\", \"4a643cd0cc13\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"The officer sits against the wall and does not look up.\", \"军官靠墙坐着，头也不抬。\", \"1045b0949b80\"]]"}]},{"id":115,"name":"exit-meiwu--hall","type":"exit","x":441.6,"y":237.6,"width":12.8,"height":12.0,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"meiwu--hall"},{"name":"side","type":"string","value":"N"}]},{"id":116,"name":"exit-meiwu--mother","type":"exit","x":185.6,"y":221.6,"width":12.8,"height":12.0,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"meiwu--mother"},{"name":"side","type":"string","value":"N"}]},{"id":117,"name":"exit-meiwu--diaochan","type":"exit","x":697.6,"y":221.6,"width":12.8,"height":12.0,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"meiwu--diaochan"},{"name":"side","type":"string","value":"N"}]},{"id":118,"name":"exit-meiwu-road","type":"exit","x":1008,"y":704,"width":16,"height":64,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"meiwu-road"},{"name":"side","type":"string","value":"E"}]},{"id":119,"name":"exit-liangzhou","type":"exit","x":0,"y":704,"width":16,"height":64,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"liangzhou"},{"name":"side","type":"string","value":"W"}]},{"id":120,"name":"entry-meiwu--hall","type":"entry","x":456.0,"y":254.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"from","type":"string","value":"meiwu--hall"}]},{"id":121,"name":"entry-meiwu--mother","type":"entry","x":200.0,"y":238.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"from","type":"string","value":"meiwu--mother"}]},{"id":122,"name":"entry-meiwu--diaochan","type":"entry","x":712.0,"y":238.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"from","type":"string","value":"meiwu--diaochan"}]},{"id"