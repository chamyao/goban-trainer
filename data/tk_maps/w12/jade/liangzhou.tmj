e":"label_zh","type":"string","value":"庄堡"}]},{"id":229,"name":"v3","type":"spot","x":352,"y":283.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"12-a16c"},{"name":"label","type":"string","value":"The post town: the pavilion"},{"name":"label_zh","type":"string","value":"驿镇：亭"}]},{"id":230,"name":"road-out","type":"spot","x":272,"y":219.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"12-a16m"},{"name":"label","type":"string","value":"The road east"},{"name":"label_zh","type":"string","value":"东去之路"}]},{"id":231,"name":"rengu","type":"spot","x":520.0,"y":235.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"12-a17"},{"name":"label","type":"string","value":"The mouth of Ren Valley"},{"name":"label_zh","type":"string","value":"任谷口"}]},{"id":232,"name":"npc-1","type":"npc","x":296.0,"y":206.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.elder"},{"name":"sprite","type":"string","value":"f_elder"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"headman"},{"name":"until","type":"string","value":"12-a16b"},{"name":"when","type":"string","value":"node:a16a"},{"name":"intro","type":"string","value":"[[\"n\", \"A headman sits on a stone by the road, a stick across his knees. “You're spreading tales from Chang'an. Convince me first.”\", \"一个乡老坐在路边石上，膝上横着一根棍子。“你们在传长安来的话。先说服我。”\", \"83c7300cce49\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“…Then it's true. I'll tell the others myself.”\", \"“……那就是真的了。我亲自去告诉大家。”\", \"2f8178f2e3a1\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"“I've told them. They're coming.”\", \"“我已经告诉他们了。他们都来了。”\", \"1cab71e29afa\"]]"}]},{"id":233,"name":"npc-2","type":"npc","x":328.0,"y":318.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.official"},{"name":"sprite","type":"string","value":"f_official"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"constable"},{"name":"until","type":"string","value":"12-a16c"},{"name":"face","type":"string","value":"left"},{"name":"when","type":"string","value":"node:a16b"},{"name":"intro","type":"string","value":"[[\"n\", \"The constable stands at the pavilion, arms folded. “A man without an army is just a man on a road. I've tied up better.”\", \"亭长站在亭前，抱着胳膊。“没兵的人，不过是路上一个人。比你强的我也绑过。”\", \"161d64cab8a4\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“…That's no road gang behind you. That's Liangzhou.”\", \"“……你身后不是一伙路匪。那是整个凉州。”\", \"0ee7c0e803a4\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"The constable has taken down his rope.\", \"亭长已经收起了绳子。\", \"005aadc21b85\"]]"}]},{"id":234,"name":"npc-3","type":"npc","x":552.0,"y":238.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"scout"},{"name":"until","type":"string","value":"12-a17"},{"name":"when","type":"string","value":"node:a16m"},{"name":"intro","type":"string","value":"[[\"n\", \"A scout calls down from his post on the hill. “General! Lü Bu's dust on the east road. Want to know how many?”\", \"一个斥候在山上的哨位朝下喊。“将军！东路上有吕布的尘头。要知道有多少人吗？”\", \"58eba3cfb378\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“Then you know as well as I do. Ready the gongs and drums.”\", \"“那你和我一样清楚了。备好金鼓。”\", \"e11b0d2d9cc5\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"The scout watches the east road.\", \"斥候望着东路。\", \"3661b05d7f14\"]]"}]},{"id":235,"name":"npc-4","type":"npc","x":184.0,"y":222.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“No pardon. The envoy came back with nothing. I'm going home to my mother.”\", \"“求赦不得。使者空手回来了。我要回家找我娘去。”\", \"8551622fbda8\"]]"},{"name":"until","type":"string","value":"12-a16"}]},{"id":236,"name":"npc-5","type":"npc","x":392.0,"y":222.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.elder"},{"name":"sprite","type":"string","value":"f_elder2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Wang Yun? A man of the east. What does he know of Liangzhou?”\", \"“王允？一个东边人。他懂什么凉州？”\", \"1f501f04054a\"]]"},{"name":"until","type":"string","value":"12-a16a"}]},{"id":237,"name":"npc-6","type":"npc","x":424.0,"y":174.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.elder"},{"name":"sprite","type":"string","value":"f_elder2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Then we're dead men either way. Better on horseback.”\", \"“那横竖都是死。死在马背上强些。”\", \"2ce21b85c9ff\"]]"},{"name":"when","type":"string","value":"node:a16a"}]},{"id":238,"name":"npc-7","type":"npc","x":296.0,"y":190.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.woman"},{"name":"sprite","type":"string","value":"folk.woman#3"},{"name":"wander","type":"bool","value":false},{"name":"say","type":"string","value":"[[\"n\", \"“We have a wall. Walls kept out the Qiang. Will they keep out Chang'an?”\", \"“我们有墙。墙挡得住羌人。挡得住长安吗？”\", \"5276cd695cf5\"]]"}]},{"id":239,"name":"npc-8","type":"npc","x":312.0,"y":254.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Better die marching than in our beds.”\", \"“死在行军路上，强过死在床上。”\", \"73b52fd08031\"]]"},{"name":"when","type":"string","value":"node:a16c"}]},{"id":240,"name":"exit-changan","type":"exit","x":0,"y":208,"width":16,"height":32,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"changan"},{"name":"side","type":"string","value":"W"}]},{"id":241,"name":"exit-liangzhou--camp","type":"exit","x":209.6,"y":173.6,"width":12.8,"height":7.2,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"liangzhou--camp"},{"name":"side","type":"string","value":"N"}]},{"id":242,"name":"exit-liangzhou--tent-2","type":"exit","x":209.6,"y":109.6,"width":12.8,"height":7.2,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"liangzhou--tent-2"},{"name":"side","type":"string","value":"N"}]},{"id":243,"name":"exit-liangzhou--v1","type":"exit","x":385.6,"y":173.6,"width":12.8,"height":7.2,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"liangzhou--v1"},{"name":"side","type":"string","value":"N"}]},{"id":244,"name":"exit-liangzhou--v2","type":"exit","x":313.6,"y":173.6,"width":12.8,"height":7.2,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"liangzhou--v2"},{"name":"side","type":"string","value":"N"}]},{"id":245,"name