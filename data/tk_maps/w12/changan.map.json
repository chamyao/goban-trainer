   }
  },
  {
   "id": "npc-7",
   "kind": "folk.soldier",
   "x": 50.5,
   "y": 37.9,
   "say": [
    "“In Liangzhou we ride before we walk. These Chang'an streets are too narrow for a horse to stretch.”"
   ],
   "in": [
    "capital"
   ]
  },
  {
   "id": "npc-8",
   "kind": "folk.villager",
   "x": 25.5,
   "y": 25.9,
   "say": [
    "“Second watch, and all's well. Keep your lantern lit, sir. The Liangzhou patrols take a dark street for a guilty one.”"
   ],
   "in": [
    "night-a2",
    "night-a6"
   ]
  },
  {
   "id": "npc-9",
   "kind": "folk.maiden",
   "x": 16.5,
   "y": 37.9,
   "say": [
    "“They say Lady Diaochan went in the covered carriage, straight to the Grand Preceptor's.”"
   ],
   "until": "12-a10",
   "when": "node:a5",
   "in": [
    "night-a6",
    "capital"
   ]
  },
  {
   "id": "npc-10",
   "kind": "folk.villager",
   "x": 47.5,
   "y": 20.9,
   "say": [
    "“The Grand Preceptor's at Meiwu. The streets breathe again.”"
   ],
   "in": [
    "away"
   ]
  },
  {
   "id": "npc-11",
   "kind": "folk.soldier",
   "x": 21.5,
   "y": 13.9,
   "say": [
    "“General Lü stood on that ridge till the dust was gone. Didn't say a word.”"
   ],
   "in": [
    "away"
   ]
  },
  {
   "id": "npc-12",
   "kind": "folk.official",
   "x": 23.5,
   "y": 28.9,
   "say": [
    "“The Son of Heaven is recovered from his illness! All officials to the Weiyang Hall!”"
   ],
   "in": [
    "gate-day"
   ]
  },
  {
   "id": "npc-13",
   "kind": "folk.official",
   "x": 29.5,
   "y": 37.9,
   "say": [
    "“Why are we all wearing swords to a celebration?”"
   ],
   "in": [
    "gate-day"
   ]
  },
  {
   "id": "npc-14",
   "kind": "folk.villager",
   "x": 29.5,
   "y": 25.9,
   "say": [
    "“Sell the coat! Buy wine! The old traitor is dead!”"
   ],
   "in": [
    "after"
   ]
  },
  {
   "id": "npc-15",
   "kind": "folk.villager",
   "x": 21.5,
   "y": 21.9,
   "say": [
    "“That one's for my brother, who died on the road from Luoyang.”"
   ],
   "in": [
    "after"
   ]
  },
  {
   "id": "npc-16",
   "kind": "folk.child",
   "x": 32.5,
   "y": 34.9,
   "say": [
    "“Ten thousand years! Ten thousand years!”"
   ],
   "in": [
    "after"
   ]
  },
  {
   "id": "npc-17",
   "kind": "folk.official",
   "x": 18.5,
   "y": 21.9,
   "say": [
    "“I held a cup today. My hand didn't shake once.”"
   ],
   "in": [
    "after"
   ]
  },
  {
   "id": "npc-18",
   "kind": "folk.villager",
   "x": 33.5,
   "y": 21.9,
   "say": [
    "“The Liangzhou men are inside! Li Meng and Wang Fang opened the gates!”"
   ],
   "in": [
