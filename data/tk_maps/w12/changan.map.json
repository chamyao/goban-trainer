   ]
  },
  {
   "id": "npc-19",
   "kind": "folk.woman",
   "x": 49.5,
   "y": 21.9,
   "say": [
    "“East! Get to the Xuanping Gate, the Son of Heaven is there!”"
   ],
   "in": [
    "sack"
   ]
  },
  {
   "id": "npc-20",
   "kind": "folk.villager",
   "x": 23.5,
   "y": 27.9,
   "say": [
