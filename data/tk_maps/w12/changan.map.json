 "npcs": [
  {
   "id": "npc-1",
   "kind": "folk.soldier",
   "x": 29.5,
   "y": 21.9,
   "say": [
    "“Keep to the side lanes. The middle of the avenue is the Son of Heaven's. And the Grand Preceptor's.”"
   ],
   "face": "W",
   "in": [
    "capital",
    "night-a2",
    "night-a6",
    "away"
   ]
  },
  {
   "id": "npc-2",
   "kind": "folk.villager",
   "x": 23.5,
   "y": 26.9,
   "say": [
    "“Two hundred and fifty thousand of us built it. Walls as high as these. Twenty years of grain inside, they say.”"
   ],
   "in": [
    "capital",
    "away"
   ]
  },
  {
   "id": "npc-3",
   "kind": "folk.woman",
   "x": 48.5,
   "y": 19.9,
   "say": [
    "“They drove us west from Luoyang like geese. My house is ash, and here I sell turnips.”"
   ],
   "in": [
    "capital",
    "away"
   ]
  },
  {
   "id": "npc-4",
   "kind": "folk.official",
   "x": 17.5,
   "y": 21.9,
   "say": [
    "“He laughed, and went on eating. I couldn't hold my chopsticks. I still can't, some days.”"
   ],
   "when": "node:a1",
   "in": [
    "capital",
    "away"
   ]
  },
  {
   "id": "npc-5",
   "kind": "folk.child",
   "x": 32.5,
   "y": 33.9,
   "say": [
    "“Mother says don't look at the soldiers with the long halberds.”"
   ],
   "in": [
    "capital"
   ]
  },
  {
   "id": "npc-6",
   "kind": "folk.soldier",
   "x": 38.5,
   "y": 37.9,
   "say": [
    "“The Grand Preceptor receives no one today.”"
   ],
   "face": "S",
   "in": [
    "capital",
    "night-a2",
    "night-a6"
   ],
   "watch": {
