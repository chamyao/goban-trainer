 "npcs": [
  {
   "id": "npc-3",
   "kind": "folk.official",
   "x": 33.5,
   "y": 4.9,
   "say": [],
   "challenge": "runner",
   "intro": [
    "A runner in the Chancellor's colours steps into your path. “Minister Wang, out on foot? The Grand Preceptor likes to know who walks where.”"
   ],
   "win": [
    "“Nothing worth reporting, then. Good day, Minister.”"
   ],
   "done": [
    "The runner watches you pass, and says nothing."
   ],
   "until": "12-a3",
   "face": "left",
   "when": "node:a2"
  },
  {
   "id": "npc-4",
   "kind": "folk.soldier",
   "x": 32.5,
   "y": 17.9,
   "say": [],
   "challenge": "flyingbear",
   "intro": [
    "A Flying Bear soldier lounges against the wall, dice in his fist. “Bored, old man? Play me. Lose, and you buy the wine.”"
   ],
   "win": [
    "“Hah! The old man bites. Go on.”"
   ],
   "done": [
    "“Not again, old man. My purse can't take it.”"
   ],
   "until": "12-a3",
   "when": "node:a2"
  },
  {
   "id": "npc-5",
   "kind": "folk.soldier",
   "x": 20.5,
   "y": 10.9,
   "say": [],
   "challenge": "patrol",
   "intro": [
    "A Flying Bear patrol fills the lane to Huang Wan's gate. “Visiting late, Minister? Every lane in Chang'an answers to the Grand Preceptor.”"
   ],
   "win": [
    "“On your way, then. Quickly.”"
   ],
   "done": [
    "The patrol has moved on to the next lane."
   ],
   "until": "12-a12b",
   "face": "down",
   "when": "node:a11"
  },
  {
   "id": "npc-6",
   "kind": "folk.villager",
   "x": 16.5,
   "y": 22.9,
   "say": [],
   "challenge": "informer",
   "intro": [
    "A man in a plain coat has sat by Shisun Rui's gate all morning. “A game while you wait, Minister? I have time. I have nothing but time.”"
   ],
   "win": [
    "“You play like a man with nothing to hide.”"
   ],
   "done": [
    "The man in the plain coat has gone."
   ],
   "until": "12-a12a",
   "when": "node:a11"
  },
  {
   "id": "npc-7",
   "kind": "folk.elder",
   "x": 28.5,
   "y": 13.9,
   "say": [],
   "challenge": "scholar",
   "intro": [
    "“Sit, Minister. In this city it's safer to talk about stones than people.”"
   ],
   "win": [
    "“Ha. You read the board the way you read a room.”"
   ],
   "done": [
    "“Another day, Minister. The stones keep.”"
   ],
   "until": "12-a17"
  },
  {
   "id": "npc-8",
   "kind": "folk.soldier",
   "x": 28.5,
   "y": 8.9,
   "say": [],
   "challenge": "officer",
   "intro": [
    "A Liangzhou officer steps out of a dark lane. “Out after the drum, Minister? Play me for your way home.”"
   ],
   "win": [
    "“Go on, then. I never saw you.”"
   ],
   "done": [
    "“Still out, Minister?”"
   ],
   "until": "12-a6",
   "when": "node:a5"
  },
  {
   "id": "npc-9",
   "kind": "folk.soldier",
   "x": 25.5,
   "y": 17.9,
   "say": [
    "“Keep to the side lanes. The middle of the avenue is the Son of Heaven's. And the Grand Preceptor's.”"
   ],
   "until": "12-a14"
  },
  {
   "id": "npc-10",
   "kind": "folk.villager",
   "x": 25.5,
   "y": 16.9,
   "say": [
    "“Two hundred and fifty thousand of us built Meiwu. Walls as high as these. Twenty years of grain inside, they say.”"
   ],
   "until": "12-a14"
  },
  {
   "id": "npc-11",
   "kind": "folk.woman",
   "x": 30.5,
   "y": 17.9,
   "say": [
    "“They drove us west from Luoyang like geese. My house is ash, and here I sell turnips.”"
   ],
   "until": "12-a14"
  },
  {
   "id": "npc-12",
   "kind": "folk.official",
   "x": 24.5,
   "y": 16.9,
   "say": [
    "“He laughed, and went on eating. I couldn't hold my chopsticks. I still can't, some days.”"
   ],
   "until": "12-a14",
   "when": "node:a1"
  },
  {
   "id": "npc-13",
   "kind": "folk.child",
   "x": 20.5,
   "y": 16.9,
   "say": [
    "“Mother says don't look at the soldiers with the long halberds.”"
   ],
   "wander": true,
   "until": "12-a14"
  },
  {
   "id": "npc-14",
   "kind": "folk.soldier",
   "x": 32.5,
   "y": 11.9,
   "say": [
    "“The Grand Preceptor receives no one today.”"
   ],
   "until": "12-a14",
   "face": "down"
  },
  {
   "id": "npc-15",
   "kind": "folk.soldier",
   "x": 33.5,
   "y": 3.9,
   "say": [
    "“In Liangzhou we ride before we walk. These Chang'an streets are too narrow for a horse to stretch.”"
   ],
   "until": "12-a14"
  },
  {
   "id": "npc-19",
   "kind": "folk.soldier",
   "x": 23.5,
   "y": 16.9,
   "say": [
    "“General Lü stood on that ridge till the dust was gone. Didn't say a word.”"
   ],
   "until": "12-a12",
   "when": "node:a10"
  },
  {
   "id": "npc-20",
   "kind": "folk.villager",
   "x": 26.5,
   "y": 13.9,
   "say": [
    "“The Grand Preceptor's at Meiwu. The streets breathe again.”"
   ],
   "until": "12-a13",
   "when": "node:a10"
  },
  {
   "id": "npc-21",
   "kind": "folk.official",
   "x": 14.5,
   "y": 11.9,
   "say": [
    "“The Son of Heaven is recovered from his illness! All officials to the Weiyang Hall!”"
   ],
   "until": "12-a14",
   "when": "node:a13c"
  },
  {
   "id": "npc-22",
   "kind": "folk.official",
   "x": 7.5,
   "y": 11.9,
   "say": [
    "“Why are we all wearing swords to a celebration?”"
   ],
   "until": "12-a14",
   "when": "node:a13c"
  },
  {
   "id": "npc-23",
   "kind": "folk.villager",
   "x": 25.5,
   "y": 13.9,
   "say": [
    "“Sell the coat! Buy wine! The old traitor is dead!”"
   ],
   "until": "12-a16",
   "when": "node:a14"
  },
  {
   "id": "npc-24",
   "kind": "folk.villager",
   "x": 23.5,
   "y": 19.9,
   "say": [
    "“That one's for my brother, who died on the road from Luoyang.”"
   ],
   "until": "12-a16",
   "when": "node:a14"
  },
  {
   "id": "npc-25",
   "kind": "folk.child",
   "x": 23.5,
   "y": 11.9,
   "say": [
    "“Ten thousand years! Ten thousand years!”"
   ],
   "until": "12-a16",
   "when": "node:a14"
  },
  {
   "id": "npc-26",
   "kind": "folk.official",
   "x": 32.5,
   "y": 16.9,
   "say": [
    "“I held a cup today. My hand didn't shake once.”"
   ],
   "until": "12-a16",
   "when": "node:a14"
  },
  {
   "id": "npc-27",
   "kind": "folk.villager",
   "x": 32.5,
   "y": 20.9,
   "say": [
    "“The Liangzhou men are inside! Li Meng and Wang Fang opened the gates!”"
   ],
   "when": "node:a17"
  },
  {
   "id": "npc-28",
   "kind": "folk.woman",
   "x": 19.5,
   "y": 21.9,
   "say": [
    "“East! Get to the Xuanping Gate, the Son of Heaven is there!”"
   ],
   "when": "node:a17"
  },
  {
   "id": "npc-29",
   "kind": "folk.villager",
   "x": 22.5,
   "y": 19.9,
   "say": [
    "“I built his walls. Now his men burn mine.”"
   ],
   "when": "node:a17"
  }
 ],
