point":true,"properties":[{"name":"kind","type":"string","value":"folk.elder"},{"name":"sprite","type":"string","value":"f_elder2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Cao Bao keeps the west gate. A Danyang man, and Lü Bu is his son-in-law, you know.”\", \"“曹豹守西门。丹阳人，吕布是他女婿，你知道吧。”\", \"e5a698ad6f02\"]]"},{"name":"in","type":"string","value":"[\"guest\", \"moon\"]"}]},{"id":55,"name":"npc-3","type":"npc","x":280.0,"y":478.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“No one troubles the Lord Liu's ladies. General Lü's orders.”\", \"“刘使君的家眷，谁也不许打扰。吕将军的命令。”\", \"a8b95e1a79fb\"]]"},{"name":"in","type":"string","value":"[\"held\"]"}]},{"id":56,"name":"drinker","type":"npc","x":536.0,"y":478.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_farmer2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"drinker"},{"name":"until","type":"string","value":"14-x9"},{"name":"when","type":"string","value":"node:x1"},{"name":"view","type":"string","value":"4"},{"name":"intro","type":"string","value":"[[\"n\", \"One of Zhang Fei's drinking companions sways out of the wine shop. “You're the one he calls the slave of three surnames! A game, and if you lose, you drink!”\", \"张飞的一个酒友摇摇晃晃走出酒肆。“你就是他说的三姓家奴！来下一局，输了就喝！”\", \"d7de0b473eba\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“…Hic. You play better than he says.”\", \"“……嗝。你下得比他说的好。”\", \"c5463e687222\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"Zhang Fei's friend is asleep on the bench.\", \"张飞的酒友在长凳上睡着了。\", \"cf26c88f3b33\"]]"}]},{"id":57,"name":"danyang","type":"npc","x":152.0,"y":606.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"danyang"},{"name":"until","type":"string","value":"14-x9"},{"name":"when","type":"string","value":"node:x1"},{"name":"view","type":"string","value":"4"},{"name":"intro","type":"string","value":"[[\"n\", \"A Danyang soldier of Cao Bao's leans on his spear. “Our general's daughter married you, didn't she? Let's see if you're worth her.”\", \"曹豹手下一名丹阳兵拄着枪。“我们将军的女儿嫁给了你，是吧？看看你配不配。”\", \"7b5fa5ad6cc2\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“Hah. You'll do.”\", \"“哈。还行。”\", \"71621aa1d3ab\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"The Danyang soldier salutes.\", \"丹阳兵行了个礼。\", \"36c5a937d528\"]]"}]},{"id":58,"name":"exit-xuzhou--xz-hall","type":"exit","x":313.6,"y":365.6,"width":12.8,"height":7.2,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"xuzhou--xz-hall"},{"name":"side","type":"string","value":"N"}]},{"id":59,"name":"exit-xuzhou--lb-lodging","type":"exit","x":825.6,"y":365.6,"width":12.8,"height":7.2,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"xuzhou--lb-lodging"},{"name":"side","type":"string","value":"N"}]},{"id":60,"name":"exit-xiaopei","type":"exit","x":0,"y":448,"width":16,"height":64,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"xiaopei"},{"name":"side","type":"string","value":"W"}]},{"id":61,"name":"exit-the-xiapi-road","type":"exit","x":1264,"y":448,"width":16,"heig