olk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“I saw it. Straight through the little blade. Ji Ling went home without a fight.”\", \"“我亲眼看见的。正中小枝。纪灵没打就回去了。”\", \"8e1c576cfce3\"]]"},{"name":"when","type":"string","value":"node:x5"}]},{"id":138,"name":"falconer","type":"npc","x":344.0,"y":798.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_farmer2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"falconer"},{"name":"until","type":"string","value":"14-x10"},{"name":"when","type":"string","value":"node:x9"},{"name":"view","type":"string","value":"4"},{"name":"intro","type":"string","value":"[[\"n\", \"A falconer looks up from his bird. “Out hunting, Adviser? The hawk won't fly for a man in a hurry. Play me while she settles.”\", \"一个鹰师从鹰上抬起头。“出来打猎，先生？鹰不为心急的人飞。趁它安顿，跟我下一局。”\", \"5ad700d4801b\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“She'll fly for you now.”\", \"“这下它肯为你飞了。”\", \"bc8c9c39b112\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"The falconer's hawk is on the wing.\", \"鹰师的鹰飞起来了。\", \"06544924c6b7\"]]"}]},{"id":139,"name":"exit-xiaopei--lb-camp","type":"exit","x":301.6,"y":377.6,"width":12.0,"height":12.8,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"xiaopei--lb-camp"},{"name":"side","type":"string","value":"W"}]},{"id":140,"name":"exit-xuzhou","type":"exit","x":1648,"y":384,"width":16,"height":64,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"xuzhou"},{"name":"side","type":"string","value":"E"}]},{"id":141,"name":"entry-xiaopei--lb-camp","type":"entry","x":3