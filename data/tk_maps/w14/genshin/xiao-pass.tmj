"name":"label","type":"string","value":"The top of the pass road"},{"name":"label_zh","type":"string","value":"关道顶上"}]},{"id":68,"name":"x12","type":"spot","x":344.0,"y":283.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"14-x12"},{"name":"label","type":"string","value":"The cliff's edge above Cao Cao's camp"},{"name":"label_zh","type":"string","value":"曹营上方的崖边"},{"name":"trigger","type":"string","value":"near"}]},{"id":69,"name":"bandit","type":"npc","x":664.0,"y":542.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_farmer2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"bandit"},{"name":"until","type":"string","value":"14-x12"},{"name":"when","type":"string","value":"node:x11"},{"name":"view","type":"string","value":"4"},{"name":"guard_x","type":"float","value":672.0},{"name":"guard_y","type":"float","value":544.0},{"name":"intro","type":"string","value":"[[\"n\", \"A Taishan bandit blocks the narrow road, a club on his shoulder. “Toll, scholar. Or a game, if you're too poor for silver.”\", \"一个泰山贼扛着棍子拦住窄路。“书生，留下买路钱。没银子的话，下一局也行。”\", \"0fd7a1b3730c\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“…Go on, then. I never liked Chen Gong's lot anyway.”\", \"“……走吧。我本来就不喜欢陈宫那伙人。”\", \"04cfd6c57432\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"The bandit has melted back into the hills.\", \"贼人已隐入山中。\", \"c3aed62eee2f\"]]"}]},{"id":70,"name":"sentry","type":"npc","x":856.0,"y":670.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"sentry"},{"name":"until","type":"string","value":"14-x12"},{"name":"when","type":"string","value":"node:x11"},{"name":"view","type":"string","value":"4"},{"name":"intro","type":"string","value":"[[\"n\", \"One of Chen Gong's sentries leans on his spear by the bend. “Cold night for a walk, sir. Keep me awake a while?”\", \"陈宫的一名哨兵倚着枪站在弯道旁。“夜里冷，先生出来走走？陪我解解困？”\", \"6e401bf61dd3\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“Ha. Now I'm awake.”\", \"“哈。这下醒了。”\", \"bcc31e586d68\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"The sentry stamps his feet against the cold.\", \"哨兵跺着脚取暖。\", \"bc1282d37c8e\"]]"}]},{"id":71,"name":"sentry-fire","type":"npc","x":472.0,"y":222.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"watch","type":"string","value":"{\"id\": \"sentry-fire\", \"cone\": 16, \"beat\": [[29.5, 13.9], [49.5, 13.9], [29.5, 13.9]], \"pause\": [49.5, 13.9, 2], \"in_beats\": [\"14-x12\"], \"seen\": [[\"n\", \"“Who goes there? Oh, Master Chen. The Adviser said no one comes up tonight.” You're sent back down the road.\", \"“什么人？哦，陈先生。陈公台说今夜谁也不许上来。”你被打发下山去了。\", \"09c84c206a34\"]], \"back_to\": \"pass-foot\", \"shape\": \"U\"}"}]},{"id":72,"name":"sentry-edge","type":"npc","x":408.0,"y":94.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"watch","type":"string","value":"{\"id\": \"sentry-edge\", \"cone\": 16, \"beat\": [[25.5, 5.9], [25.5, 21.9], [25.5, 5.9]], \"pause\": [25.5, 5.9, 3], \"in_beats\": [\"14-x12\"], \"seen\": [[\"n\", \"“Who goes there? Oh, Master Chen. The Adviser said no one comes up tonight.” You're sent back down the road.\", \"“什么人？哦，陈先生。陈公台说今夜谁也不许上来。”你被打发下山去了。\", \"09c84c206a34\"]], \"back_to\": \"pass-foot\", \"shape\": \"U\"}"}]},{"id":73,"name":"exit-xuzhou","type":"exit","x":768,"y":1008,"width":64,"height":16,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"xuzhou"},{"name":"side","type":"string","value":"S"}]},{"id":74,"name":"entry-xuzhou","type":"entry","x":792.0,"y":926.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"from","type":"string","value":"xuzhou"}]},{"id":75,"name":"entry","type":"entry","x":792.0,"y":926.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true}]}]}