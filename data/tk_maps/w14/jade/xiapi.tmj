illager"},{"name":"sprite","type":"string","value":"f_farmer"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“The water's up to the doorsteps on the south side. The east gate's the only dry way left.”\", \"“南边的水已漫到门槛了。只剩东门这一条旱路。”\", \"d7583523a938\"]]"},{"name":"in","type":"string","value":"[\"flood2\"]"}]},{"id":53,"name":"grumbler","type":"npc","x":664.0,"y":670.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"grumbler"},{"name":"until","type":"string","value":"14-x16"},{"name":"when","type":"string","value":"node:x13"},{"name":"view","type":"string","value":"4"},{"name":"intro","type":"string","value":"[[\"n\", \"An officer of Hou Cheng's spits in the gutter. “No wine, no pay, and the general up there with his women. Play me, General, and tell me why I should stay.”\", \"侯成手下一名军官往沟里啐了一口。“没酒，没饷，将军在楼上陪着妻妾。跟我下一局，将军，说说我为什么要留下。”\", \"450bb02d7c0d\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“…Fair enough. I'll stay. For now.”\", \"“……也罢。我留下。暂且留下。”\", \"e6df8ad4e851\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"The officer goes back to his post, still muttering.\", \"军官回到岗位上，还在嘀咕。\", \"bbc00c71c487\"]]"}]},{"id":54,"name":"wall-sentry","type":"npc","x":1240.0,"y":798.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"wall-sentry"},{"name":"until","type":"string","value":"14-x16"},{"name":"when","type":"string","value":"node:x13"},{"name":"view","type":"string","value":"4"},{"name":"intro","type":"string","value":"[[\"n\", \"A sentry at the foot of the wall stairs stands to. “General! I've counted Cao Cao's fires all night. Shall I count them for you?”\", \"城墙梯下的一名哨兵立正。“将军！曹营的火我数了一夜。要我数给您听吗？”\", \"1691e250bb4b\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“Then you know what I know.”\", \"“那你知道的，我也知道了。”\", \"e3e8dcc53a72\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"The sentry has gone back up the wall.\", \"哨兵已回到城墙上。\", \"97812fe5b049\"]]"}]},{"id":55,"name":"guard-causeway","type":"npc","x":856.0,"y":606.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"watch","type":"string","value":"{\"id\": \"guard-causeway\", \"cone\": 20, \"beat\": [[53.5, 37.9], [73.5, 37.9], [53.5, 37.9]], \"pause\": [73.5, 37.9, 2], \"in_beats\": [\"14-x19\"], \"seen\": [[\"n\", \"“Who's at the horses? General Hou?” The guard peers through the rain, and you back off into the dark.\", \"“谁在马那边？侯将军？”守卒在雨中张望，你退回暗处。\", \"fc72f9b64c9b\"]], \"back_to\": \"stables-door\", \"shape\": \"U\"}"}]},{"id":56,"name":"guard-gate","type":"npc","x":1240.0,"y":606.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"watch","type":"string","value":"{\"id\": \"guard-gate\", \"cone\": 16, \"beat\": [[77.5, 37.9]], \"turns\": [\"left\", \"down\"], \"in_beats\": [\"14-x19\"], 