done","type":"string","value":"[[\"n\", \"The falconer's hawk is on the wing.\", \"鹰师的鹰飞起来了。\", \"06544924c6b7\"]]"}]},{"id":139,"name":"exit-xiaopei--lb-camp","type":"exit","x":301.6,"y":377.6,"width":12.0,"height":12.8,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"xiaopei--lb-camp"},{"name":"side","type":"string","value":"W"}]},{"id":140,"name":"exit-xuzhou","type":"exit","x":1648,"y":384,"width":16,"height":64,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"xuzhou"},{"name":"side","type":"string","value":"E"}]},{"id":141,"name":"entry-xiaopei--lb-camp","type":"entry","x":312.0,"y":398.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"from","type":"string","value":"xiaopei--lb-camp"}]},{"id":142,"name":"entry-xuzhou","type":"entry","x":1560.0,"y":414.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"from","type":"string","value":"xuzhou"}]},{"id":143,"name":"entry","type":"entry","x":792.0,"y":414.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true}]}]}