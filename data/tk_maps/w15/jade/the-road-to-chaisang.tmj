ing","value":"near"}]},{"id":94,"name":"npc-1","type":"npc","x":1368.0,"y":350.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.official"},{"name":"sprite","type":"string","value":"f_official"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"until","type":"string","value":"15-s14"},{"name":"when","type":"string","value":"node:s13"},{"name":"yield","type":"string","value":"{\"group\": \"chenwu\", \"reach\": 4, \"aside\": [4, -4], \"line\": [[\"n\", \"Chen Wu sees who is in the carriage, swings down from his horse, and stands aside with his hands clasped.\", \"陈武看清车里坐的是谁，翻身下马，拱着手退到路边。\", \"33ba011d935f\"]], \"caught\": [[\"n\", \"“Halt! On the Marquis's orders, no one passes!” You fall back.\", \"“站住！奉吴侯之命，谁也不许过！”你只好退了回去。\", \"69045b01d518\"]], \"back_to\": \"block-start\"}"}]},{"id":95,"name":"npc-2","type":"npc","x":1384.0,"y":350.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"until","type":"string","value":"15-s14"},{"name":"when","type":"string","value":"node:s13"},{"name":"yield","type":"string","value":"{\"group\": \"chenwu\", \"reach\": 4, \"aside\": [4, 4], \"line\": [[\"n\", \"“It's the Lady herself!” He backs his horse off the road.\", \"“是夫人本人！”他牵着马退到了路外。\", \"696c14752659\"]], \"caught\": [[\"n\", \"“Halt! On the Marquis's orders, no one passes!” You fall back.\", \"“站住！奉吴侯之命，谁也不许过！”你只好退了回去。\", \"f8899919ab16\"]], \"back_to\": \"block-start\"}"}]},{"id":96,"name":"npc-3","type":"npc","x":1368.0,"y":366.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"until","type":"string","value":"15-s14"},{"name":"when","type":"string","value":"node:s13"},{"name":"yield","type":"string","value":"{\"group\": \"chenwu\", \"reach\": 4, \"aside\": [6, -4], \"line\": [[\"n\", \"“Not our quarrel, madam.” He leads his horse aside.\", \"“夫人，这不关我们的事。”他把马牵到了一边。\", \"84cd7aa30860\"]], \"caught\": [[\"n\", \"“Halt! On the Marquis's orders, no one passes!” You fall back.\", \"“站住！奉吴侯之命，谁也不许过！”你只好退了回去。\", \"f8899919ab16\"]], \"back_to\": \"block-start\"}"}]},{"id":97,"name":"npc-4","type":"npc","x":1688.0,"y":350.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.official"},{"name":"sprite","type":"string","value":"f_official"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"until","type":"string","value":"15-s14"},{"name":"when","type":"string","value":"node:s13"},{"name":"yield","type":"string","value":"{\"group\": \"panzhang\", \"reach\": 4, \"aside\": [4, -4], \"line\": [[\"n\", \"Pan Zhang looks at Zhao Yun, then at the Lady, and dismounts. “Madam.”\", \"潘璋看看赵云，又看看夫人，下了马。“夫人。”\", \"21762c342a1e\"]], \"caught\": [[\"n\", \"“Stop the carriage!” The spears come down, and you fall back.\", \"“把车停下！”长枪一齐放平，你只好退了回去。\", \"187dd31dcbf1\"]], \"back_to\": \"block-start\"}"}]},{"id":98,"name":"npc-5","type":"npc","x":1704.0,"y":350.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"until","type":"string","value":"15-s14"},{"name":"when","type":"string","value":"node:s13"},{"name":"yield","type":"string","value":"{\"group\": \"panzhang\", \"reach\": 4, \"aside\": [4, 4], \"line\": [[\"n\", \"“Pan Zhang can argue with her himself.” He reins his horse off the road.\", \"“让潘璋自己去跟夫人说吧。”他拨转马头，离开了大路。\", \"753d581ca8a2\"]], \"caught\": [[\"n\", \"“Stop the carriage!” The spears come down, and you fall back.\", \"“把车停下！”长枪一齐放平，你只好退了回去。\", \"e48ca41374d7\"]], \"back_to\": \"block-start\"}"}]},{"id":99,"name":"npc-6","type":"npc","x":1688.0,"y":366.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"until","type":"string","value":"15-s14"},{"name":"when","type":"string","value":"node:s13"},{"name":"yield","type":"string","value":"{\"group\": \"panzhang\", \"reach\": 4, \"aside\": [6, 4], \"line\": [[\"n\", \"He lowers his spear and gets out of the way.\", \"他放下长枪，让开了路。\", \"382a3db297f7\"]], \"caught\": [[\"n\", \"“Stop the carriage!” The spears come down, and you fall back.\", \"“把车停下！”长枪一齐放平，你只好退了回去。\", \"e48ca41374d7\"]], \"back_to\": \"block-start\"}"}]},{"id":100,"name":"exit-nanxu","type":"exit","x":0,"y":320,"width":16,"height":64,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"nanxu"},{"name":"side","type":"string","value":"W"}]},{"id":101,"name":"exit-liulangpu","type":"exit","x":2544,"y":320,"width":16,"height":64,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"liulangpu"},{"name":"side","type":"string","value":"E"}]},{"id":102,"name":"entry-nanxu","type":"entry","x":88.0,"y":350.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"from","type":"string","value":"nanxu"}]},{"id":103,"name"