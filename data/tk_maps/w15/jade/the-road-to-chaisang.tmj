type":"string","value":"开阔的大路"},{"name":"trigger","type":"string","value":"near"}]},{"id":80,"name":"npc-1","type":"npc","x":1368.0,"y":286.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"yield","type":"bool","value":true},{"name":"back_to","type":"string","value":"block-start"},{"name":"yield_say","type":"string","value":"[[\"n\", \"“It's the Lady herself!” He swings down from his horse and stands aside.\", \"“是夫人本人！”他翻身下马，站到路边。\", \"b4123fa49196\"]]"}]},{"id":81,"name":"npc-2","type":"npc","x":1368.0,"y":350.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"yield","type":"bool","value":true},{"name":"back_to","type":"string","value":"block-start"},{"name":"yield_say","type":"string","value":"[[\"n\", \"“Madam, we were only told to bring you back…” He looks at Zhao Yun, and steps aside.\", \"“夫人，我们只是奉命请您回去……”他看了看赵云，让开了。\", \"0881ec10579d\"]]"}]},{"id":82,"name":"npc-3","type":"npc","x":1368.0,"y":414.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"yield","type":"bool","value":true},{"name":"back_to","type":"string","value":"block-start"},{"name":"yield_say","type":"string","value":"[[\"n\", \"“Dismount! It's the Marquis's sister!” He backs his horse off the road.\", \"“快下马！是吴侯的妹妹！”他牵着马退到路外。\", \"96454a2bfc5c\"]]"}]},{"id":83,"name":"npc-4","type":"npc","x":1688.0,"y":286.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"yield","type":"bool","value":true},{"name":"back_to","type":"string","value":"block-start"},{"name":"yield_say","type":"string","value":"[[\"n\", \"“Chen Wu said nothing about facing her!” He lowers his spear and gets out of the way.\", \"“陈武可没说要跟夫人面对面！”他放下长枪，让开了路。\", \"b13865ee7d1c\"]]"}]},{"id":84,"name":"npc-5","type":"npc","x":1688.0,"y":350.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"yield","type":"bool","value":true},{"name":"back_to","type":"string","value":"block-start"},{"name":"yield_say","type":"string","value":"[[\"n\", \"“Pan Zhang can argue with her himself.” He reins his horse round and off the road.\", \"“让潘璋自己去跟夫人说吧。”他拨转马头，离开了大路。\", \"753d581ca8a2\"]]"}]},{"id":85,"name":"npc-6","type":"npc","x":1688.0,"y":414.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"yield","type":"bool","value":true},{"name":"back_to","type":"string","value":"block-start"},{"name":"yield_say","type":"string","value":"[[\"n\", \"“Not our quarrel, madam. Not our quarrel.” He leads his horse into the ditch.\", \"“夫人，这不关我们的事，不关我们的事。”他把马牵进了路边的沟里。\", \"f1910f12dd01\"]]"}]},{"id":86,"name":"exit-nanxu","type":"exit","x":0,"y":320,"width":16,"height":64,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"nanxu"},{"name":"side","type":"string","value":"W"}]},{"id":87,"name":"exit-liulangpu","type":"exit","x":2544,"y":320,"width":16,"height":64,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"liulangpu"},{"name":"side","type":"string","value":"E"}]},{"id":88,"name":"entry-nanxu","type":"entry","x":88.0,"y":350.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"from","type":"string","value":"nanxu"}]},{"id":89,"name":"entry-liulangpu","type":"entry","x":2456.0,"y":350.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"from","type":"string","value":"liulangpu"}]},{"id":90,"name":"entry","type":"entry","x":88.0,"y":350.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true}]}]}