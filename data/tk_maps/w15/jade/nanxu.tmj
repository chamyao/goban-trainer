r","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Red on every door. Ours too!”\", \"“家家门口都挂红了。我们家也挂上！”\", \"1a453dc8c6c9\"]]"},{"name":"gossip","type":"string","value":"{\"tells\": [\"g-h12\"], \"in_beats\": [\"s4\"], \"relay\": true}"},{"name":"in","type":"string","value":"[\"news\"]"}]},{"id":203,"name":"g-h12","type":"npc","x":1176.0,"y":862.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.porter"},{"name":"sprite","type":"string","value":"f_farmer"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“The whole city's red, right up to the palace.”\", \"“全城都红了，一直红到国太府门口。”\", \"5ac8fe375dca\"]]"},{"name":"gossip","type":"string","value":"{\"tells\": [], \"in_beats\": [\"s4\"], \"relay\": true}"},{"name":"in","type":"string","value":"[\"news\"]"}]},{"id":204,"name":"wu-gatekeeper","type":"npc","x":1048.0,"y":606.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“The Dowager is at her prayers. Nothing's been said here about any wedding.”\", \"“国太正在念经。这里没人说过什么婚事。”\", \"3ec3d70dd2e8\"]]"},{"name":"in","type":"string","value":"[\"arrival\", \"news\"]"}]},{"id":205,"name":"npc-17","type":"npc","x":792.0,"y":606.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_farmer"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Red cloth everywhere today. Is it a festival?”\", \"“今天到处挂红绸。过节吗？”\", \"f33a2a31768a\"]]"},{"name":"in","type":"string","value":"[\"news\"]"}]},{"id":206,"name":"npc-18","type":"npc","x":856.0,"y":798.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.elder"},{"name":"sprite","type":"string","value":"f_elder2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“The palace is quiet today. The Dowager's at her prayers.”\", \"“国太府今天很安静。国太在念经。”\", \"e7c6745ccb36\"]]"},{"name":"in","type":"string","value":"[\"news\"]"}]},{"id":207,"name":"npc-19","type":"npc","x":472.0,"y":94.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.porter"},{"name":"sprite","type":"string","value":"f_youth"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Boats from upriver, flying red? What's all that about?”\", \"“上游来的船都挂着红绸？这是怎么回事？”\", \"f47be8230300\"]]"},{"name":"in","type":"string","value":"[\"arrival\", \"news\"]"}]},{"id":208,"name":"npc-20","type":"npc","x":792.0,"y":350.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_farmer"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“My wife says the butchers have sold out by noon.”\", \"“我老婆说，肉铺不到中午就卖光了。”\", \"c2e40b59736c\"]]"},{"name":"in","type":"string","value":"[\"news\"]"}]},{"id":209,"name":"npc-21","type":"npc","x":1240.0,"y":606.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.woman"},{"name":"sprite","type":"string","value":"folk.woman#6"},{"name":"wander","type":"bool","value":false},{"name":"say","type":"string","value":"[[\"n\", \"“I serve in the Dowager's kitchens. Nothing's been said there.”\", \"“我在国太府的厨房干活。那里谁也没提过这事。”\", \"8ec74c12bc74\"]]"},{"name":"in","type":"string","value":"[\"news\"]"}]},{"id":210,"name":"npc-22","type":"npc","x":808.0,"y":606.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_farmer"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Red lanterns on every street. The Marquis's sister is married, and the whole city's had a feast.”\", \"“每条街都挂上了红灯笼。吴侯的妹妹出嫁了，全城都在摆酒。”\", \"a986f59eee75\"]]"},{"name":"in","type":"string","value":"[\"wedding\"]"}]},{"id":211,"name":"npc-23","type":"npc","x":1304.0,"y":606.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Liu Bei's men drill outside the east gate every day. Their general's the one who rode through Changban.”\", \"“刘备的人天天在东门外操练。他们的将军就是在长坂坡杀进杀出的那位。”\", \"c26bc99d9ad9\"]]"},{"name":"in","type":"string","value":"[\"wedding\", \"winter\"]"}]},{"id":212,"name":"npc-24","type":"npc","x":792.0,"y":798.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.elder"},{"name":"sprite","type":"string","value":"f_elder2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Snow on the river. The year's nearly out, and Liu Bei hasn't left the east palace since autumn.”\", \"“江上下雪了。一年快过完了，刘备从秋天起就没出过东府。”\", \"2c4d502b32d0\"]]"},{"name":"in","type":"string","value":"[\"winter\"]"}]},{"id":213,"name":"exit-nanxu--sq-hall","type":"exit","x":633.6,"y":301.6,"width":12.8,"height":12.0,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"nanxu--sq-hall"},{"name":"side","type":"string","value":"N"}]},{"id":214,"name":"exit-nanxu--east-palace","type":"exit","x":1113.6,"y":301.6,"width":12.8,"height":12.0,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"nanxu--east-palace"},{"name":"side","type":"string","value":"N"}]},{"id":215,"name":"exit-nanxu--wu-hall","type":"exit","x":1113.6,"y":646.4,"width":12.8,"height":12.0,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"nanxu--wu-hall"},{"name":"side","type":"string","value":"S"},{"name":"open_to","type":"string","value":"[\"told:wu-gatekeeper\"]"},{"name":"refuse","type":"string","value":"[[\"n\", \"Lady Wu's gate is quiet. The news hasn't reached her yet.\", \"国太府门前一片安静。消息还没传到她耳朵里。\", \"e28a2ee0ecbe\"]]"}]},{"id":216,"name":"exit-the-road-to-chaisang","type":"exit","x":0,"y":576,"width":16,"height":64,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"the-road-to-chaisang"},{"name":"side","type":"string","value":"W"}]},{"id":217,"name":"exit-sweet-dew-temple","type":"exit","x":1776,"y":128,"width":16,"height":64,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"sweet-dew-temple"},{"name":"side","type":"string","value":"E"}]},{"id":218,"name":"entry-nanxu--sq-hall","type":"entry","x":648.0,"y":318.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"from","type":"string","value":"nanxu--sq-hall"}]},{"id":219,"name":"entry-nanxu--east-palace","type":"entry","x":1128.0,"y":318.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"from","type":"string","value":"nanxu--east-palace"}]},{"id":220,"name":"entry-nanxu--wu-hall","type":