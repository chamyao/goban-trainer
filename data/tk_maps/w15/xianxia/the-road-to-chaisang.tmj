,{"name":"label","type":"string","value":"Before the road block"},{"name":"label_zh","type":"string","value":"拦路的兵马之前"}]},{"id":131,"name":"s12","type":"spot","x":1432.0,"y":347.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"15-s12"},{"name":"label","type":"string","value":"Past the road block"},{"name":"label_zh","type":"string","value":"过了拦路的兵马"},{"name":"trigger","type":"string","value":"near"}]},{"id":132,"name":"block2-start","type":"spot","x":1752.0,"y":347.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":""},{"name":"label","type":"string","value":"Where the pursuit caught up"},{"name":"label_zh","type":"string","value":"追兵赶上来的地方"}]},{"id":133,"name":"s13","type":"spot","x":2968.0,"y":347.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"15-s13"},{"name":"label","type":"string","value":"The open road"},{"name":"label_zh","type":"string","value":"开阔的大路"},{"name":"trigger","type":"string","value":"near"}]},{"id":134,"name":"npc-1","type":"npc","x":920.0,"y":350.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.official"},{"name":"sprite","type":"string","value":"f_official"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"until","type":"string","value":"15-s12"},{"name":"when","type":"string","value":"node:s11"},{"name":"yield","type":"string","value":"{\"group\": \"xusheng\", \"reach\": 4, \"aside\": [4, -4], \"line\": [[\"n\", \"Xu Sheng's captain sees who is in the carriage, and his hand comes off his sword. “Make way!”\", \"徐盛的部将看清车里坐的是谁，手从剑上放了下来。“让路！”\", \"8c35157c97cb\"]], \"caught\": [[\"n\", \"“Halt! On Grand Commander Zhou's orders, no one passes!” You fall back.\", \"“站住！奉周都督将令，谁也不许过去！”你被挡了回来。\", \"b2590200bf92\"]], \"back_to\": \"block1-start\"}"}]},{"id":135,"name":"npc-2","type":"npc","x":936.0,"y":350.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"until","type":"string","value":"15-s12"},{"name":"when","type":"string","value":"node:s11"},{"name":"yield","type":"string","value":"{\"group\": \"xusheng\", \"reach\": 4, \"aside\": [4, 4], \"line\": [[\"n\", \"“The Marquis's own sister…” He lowers his spear and backs off the road.\", \"“是吴侯的亲妹妹……”他放低长枪，退到路边。\", \"04d99bd1e4c2\"]], \"caught\": [[\"n\", \"“Halt! On Grand Commander Zhou's orders, no one passes!” You fall back.\", \"“站住！奉周都督将令，谁也不许过去！”你被挡了回来。\", \"1d8d1eef56d5\"]], \"back_to\": \"block1-start\"}"}]},{"id":136,"name":"npc-3","type":"npc","x":920.0,"y":366.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"until","type":"string","value":"15-s12"},{"name":"when","type":"string","value":"node:s11"},{"name":"yield","type":"string","value":"{\"group\": \"xusheng\", \"reach\": 4, \"aside\": [6, -4], \"line\": [[\"n\", \"He looks at his captain, then at her, and leads his horse aside.\", \"他看看自己的部将，又看看夫人，牵着马让到一边。\", \"deb33288a594\"]], \"caught\": [[\"n\", \"“Halt! On Grand Commander Zhou's orders, no one passes!” You fall back.\", \"“站住！奉周都督将令，谁也不许过去！”你被挡了回来。\", \"1d8d1eef56d5\"]], \"back_to\": \"block1-start\"}"}]},{"id":137,"name":"npc-4","type":"npc","x":1112.0,"y":350.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.official"},{"name":"sprite","type":"string","value":"f_official"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"until","type":"string","value":"15-s12"},{"name":"when","type":"string","value":"node:s11"},{"name":"yield","type":"string","value":"{\"group\": \"dingfeng\", \"reach\": 4, \"aside\": [4, -4], \"line\": [[\"n\", \"Ding Feng's captain swallows. “We were told it was Liu Bei. No one said anything about the Lady.” He stands aside.\", \"丁奉的部将咽了口唾沫。“上面只说是刘备，没人说夫人也在。”他退到一边。\", \"fc68f50bbdf3\"]], \"caught\": [[\"n\", \"“Stop the carriage! Those are our orders!” The spears come down, and you fall back.\", \"“把车拦住！这是军令！”长枪一齐放平，你被挡了回来。\", \"f010106dc1d2\"]], \"back_to\": \"block1-start\"}"}]},{"id":138,"name":"npc-5","type":"npc","x":1128.0,"y":350.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"until","type":"string","value":"15-s12"},{"name":"when","type":"string","value":"node:s11"},{"name":"yield","type":"string","value":"{\"group\": \"dingfeng\", \"reach\": 4, \"aside\": [4, 4], \"line\": [[\"n\", \"“Not my quarrel, madam.” He steps out of the way.\", \"“夫人，这不关我的事。”他让开了路。\", \"b1e6c2439ebc\"]], \"caught\": [[\"n\", \"“Stop the carriage! Those are our orders!” The spears come down, and you fall back.\", \"“把车拦住！这是军令！”长枪一齐放平，你被挡了回来。\", \"2cc7dcc4fa19\"]], \"back_to\": \"block1-start\"}"}]},{"id":139,"name":"npc-6","type":"npc","x":1112.0,"y":366.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"until","type":"string","value":"15-s12"},{"name":"when","type":"string","value":"node:s11"},{"name":"yield","type":"string","value":"{\"group\": \"dingfeng\", \"reach\": 4, \"aside\": [6, -4], \"line\": [[\"n\", \"He drops his eyes, and his spear with them.\", \"他垂下眼睛，长枪也跟着放低了。\", \"96a2dbb99a5d\"]], \"caught\": [[\"n\", \"“Stop the carriage! Those are our orders!” The spears come down, and you fall back.\", \"“把车拦住！这是军令！”长枪一齐放平，你被挡了回来。\", \"2cc7dcc4fa19\"]], \"back_to\": \"block1-start\"}"}]},{"id":140,"name":"npc-7","type":"npc","x":2136.0,"y":350.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.official"},{"name":"sprite","type":"string","value":"f_official"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"until","type":"string","value":"15-s13"},{"name":"when","type":"string","value":"node:s12"},{"name":"yield","type":"string","value":"{\"group\": \"chenwu\", \"reach\": 4, \"aside\": [4, -4], \"line\": [[\"n\", \"Chen Wu sees who is in the carriage, swings down from his horse, and stands aside with his hands clasped.\", \"陈武看清车里坐的是谁，翻身下马，拱着手退到路边。\", \"33ba011d935f\"]], \"caught\": [[\"n\", \"“Halt! On the Marquis's orders, no one passes!” You fall back.\", \"“站住！奉吴侯之命，谁也不许过！”你只好退了回去。\", \"69045b01d518\"]], \"back_to\": \"block2-start\"}"}]},{"id":141,"name":"npc-8","type":"npc","x":2152.0,"y":350.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"until","type":"string","value":"15-s13"},{"name":"when","type":"string","value":"node:s12"},{"name":"yield","type":"string","value":"{\"group\": \"chenwu\", \"reach\": 4, \"aside\": [4, 4], \"line\": [[\"n\", \"“It's the Lady herself!” He backs his horse off the road.\", \"“是夫人本人！”他牵着马退到了路外。\", \"696c14752659\"]], \"caught\": [[\"n\", \"“Halt! On the Marquis's orders, no one passes!” You fall back.\", \"“站住！奉吴侯之命，谁也不许过！”你只好退了回去。\", \"f8899919ab16\"]], \"back_to\": \"block2-start\"}"}]},{"id":142,"name":"npc-9","type":"npc","x":2136.0,"y":366.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"until","type":"string","value":"15-s13"},{"name":"when","type":"string","value":"node:s12"},{"name":"yield","type":"string","value":"{\"group\": \"chenwu\", \"reach\": 4, \"aside\": [6, -4], \"line\": [[\"n\", \"“Not our quarrel, madam.” He leads his horse aside.\", \"“夫人，这不关我们的事。”他把马牵到了一边。\", \"84cd7aa30860\"]], \"caught\": [[\"n\", \"“Halt! On the Marquis's orders, no one passes!” You fall back.\", \"“站住！奉吴侯之命，谁也不许过！”你只好退了回去。\", \"f8899919ab16\"]], \"back_to\": \"block2-start\"}"}]},{"id":143,"name":"npc-10","type":"npc","x":2456.0,"y":350.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.official"},{"name":"sprite","type":"string","value":"f_official"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"until","type":"string","value":"15-s13"},{"name":"when","type":"string","value":"node:s12"},{"name":"yield","type":"string","value":"{\"group\": \"panzhang\", \"reach\": 4, \"aside\": [4, -4], \"line\": [[\"n\", \"Pan Zhang looks at Zhao Yun, then at the Lady, and dismounts. “Madam.”\", \"潘璋看看赵云，又看看夫人，下了马。“夫人。”\", \"21762c342a1e\"]], \"caught\": [[\"n\", \"“Stop the carriage!” The spears come down, and you fall back.\", \"“把车停下！”长枪一齐放平，你只好退了回去。\", \"187dd31dcbf1\"]], \"back_to\": \"block2-start\"}"}]},{"id":144,"name":"npc-11","type":"npc","x":2472.0,"y":350.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"until","type":"string","value":"15-s13"},{"name":"when","type":"string","value":"node:s12"},{"name":"yield","type":"string","value":"{\"group\": \"panzhang\", \"reach\": 4, \"aside\": [4, 4], \"line\": [[\"n\", \"“Pan Zhang can argue with her himself.” He reins his horse off the road.\", \"“让潘璋自己去跟夫人说吧。”他拨转马头，离开了大路。\", \"753d581ca8a2\"]], \"caught\": [[\"n\", \"“Stop the carriage!” The spears come down, and you fall back.\", \"“把车停下！”长枪一齐放平，你只好退了回去。\", \"e48ca41374d7\"]], \"back_to\": \"block2-start\"}"}]},{"id":145,"name":"npc-12","type":"npc","x":2456.0,"y":366.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"until","type":"string","value":"15-s13"},{"name":"when","type":"string","value":"node:s12"},{"name":"yield","type":"string","value":"{\"group\": \"panzhang\", \"reach\": 4, \"aside\": [6, -4], \"line\": [[\"n\", \"He lowers his spear and gets out of the way.\", \"他放下长枪，让开了路。\", \"382a3db297f7\"]], \"caught\": [[\"n\", \"“Stop the carriage!” The spears come down, and you fall back.\", \"“把车停下！”长枪一齐放平，你只好退了回去。\", \"e48ca41374d7\"]], \"back_to\": \"block2-start\"}"}]},{"id":146,"name":"ex