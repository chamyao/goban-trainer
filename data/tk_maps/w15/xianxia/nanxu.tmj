ear"}]},{"id":189,"name":"g-dock","type":"npc","x":472.0,"y":94.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.porter"},{"name":"sprite","type":"string","value":"f_farmer"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Liu Bei, come to marry into Wu! I'll tell the neighbours.”\", \"“刘备来东吴成亲了！我得告诉街坊们。”\", \"6488f8d71e04\"]]"},{"name":"gossip","type":"string","value":"{\"tells\": [\"g-h1\"], \"in_beats\": [\"s4\"]}"},{"name":"in","type":"string","value":"[\"news\"]"}]},{"id":190,"name":"g-h1","type":"npc","x":408.0,"y":222.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_farmer"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“The Marquis's sister! Married to Liu Bei! Well, well.”\", \"“是吴侯的妹妹！嫁给刘备！真没想到。”\", \"98322203da01\"]]"},{"name":"gossip","type":"string","value":"{\"tells\": [\"g-h2\"], \"in_beats\": [\"s4\"]}"},{"name":"in","type":"string","value":"[\"news\"]"}]},{"id":191,"name":"g-h2","type":"npc","x":408.0,"y":478.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.elder"},{"name":"sprite","type":"string","value":"f_elder"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Liu Bei's come to be the Marquis's brother-in-law? Wait till the street hears this.”\", \"“刘备要做吴侯的妹夫了？这条街的人听了准吓一跳。”\", \"2ef4e066e5f8\"]]"},{"name":"gossip","type":"string","value":"{\"tells\": [\"g-h3\"], \"in_beats\": [\"s4\"]}"},{"name":"in","type":"string","value":"[\"news\"]"}]},{"id":192,"name":"g-h3","type":"npc","x":472.0,"y":350.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_farmer"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“A wedding, then! I'll pass it along.”\", \"“原来是办喜事！我去告诉别人。”\", \"70f019601cfa\"]]"},{"name":"gossip","type":"string","value":"{\"tells\": [], \"in_beats\": [\"s4\"]}"},{"name":"in","type":"string","value":"[\"news\"]"}]},{"id":193,"name":"g-market","type":"npc","x":728.0,"y":414.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.porter"},{"name":"sprite","type":"string","value":"f_farmer2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Five hundred men in red, buying for Liu Bei's wedding? I'll tell the street.”\", \"“五百个穿红衣服的人，在为刘备的婚事采办东西？我去告诉整条街。”\", \"db9bdb05a12f\"]]"},{"name":"gossip","type":"string","value":"{\"tells\": [\"g-h4\"], \"in_beats\": [\"s4\"]}"},{"name":"in","type":"string","value":"[\"news\"]"}]},{"id":194,"name":"g-h4","type":"npc","x":920.0,"y":350.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_youth"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Liu Bei! The whole city will know by evening.”\", \"“是刘备！到晚上全城都会知道。”\", \"4080564a9a7a\"]]"},{"name":"gossip","type":"string","value":"{\"tells\": [\"g-h5\"], \"in_beats\": [\"s4\"]}"},{"name":"in","type":"string","value":"[\"news\"]"}]},{"id":195,"name":"g-h5","type":"npc","x":1176.0,"y":350.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.elder"},{"name":"sprite","type":"string","value":"f_elder2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“A marriage. Somebody should tell the Dowager. Surely she knows.”\", \"“是婚事。得有人告诉国太。她总该知道吧。”\", \"d574bbee9fdd\"]]"},{"name":"gossip","type":"string","value":"{\"tells\": [], \"in_beats\": [\"s4\"]}"},{"name":"in","type":"string","value":"[\"news\"]"}]},{"id":196,"name":"g-qiao","type":"npc","x":344.0,"y":606.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.official"},{"name":"sprite","type":"string","value":"f_official"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“A lamb and wine from Liu Bei, for my master? Then it's true. My master will want the Dowager to hear it from him.”\", \"“刘备给我家老爷送来了羊和酒？那就是真的了。老爷一定想亲自去告诉国太。”\", \"4c15fd82ac00\"]]"},{"name":"gossip","type":"string","value":"{\"tells\": [\"g-h6\"], \"in_beats\": [\"s4\"]}"},{"name":"in","type":"string","value":"[\"news\"]"}]},{"id":197,"name":"g-h6","type":"npc","x":472.0,"y":606.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_youth"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Married to the Marquis's sister! I'll go and tell my cousin by the palace.”\", \"“要娶吴侯的妹妹！我去告诉住在国太府旁边的表哥。”\", \"3ed9a687965a\"]]"},{"name":"gossip","type":"string","value":"{\"tells\": [\"g-h7\", \"g-h9\"], \"in_beats\": [\"s4\"]}"},{"name":"in","type":"string","value":"[\"news\"]"}]},{"id":198,"name":"g-h7","type":"npc","x":664.0,"y":606.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.porter"},{"name":"sprite","type":"string","value":"f_farmer2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“A royal wedding! No wonder they paid in silver.”\", \"“原来是王府办喜事！怪不得付的是银子。”\", \"e90c1ac12150\"]]"},{"name":"gossip","type":"string","value":"{\"tells\": [\"g-h10\"], \"in_beats\": [\"s4\"]}"},{"name":"in","type":"string","value":"[\"news\"]"}]},{"id":199,"name":"g-h9","type":"npc","x":472.0,"y":862.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_porter"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Liu Bei and the Marquis's sister? Who'd have thought.”\", \"“刘备和吴侯的妹妹？谁想得到啊。”\", \"00c1ea818396\"]]"},{"name":"gossip","type":"string","value":"{\"tells\": [\"g-h8\"], \"in_beats\": [\"s4\"]}"},{"name":"in","type":"string","value":"[\"news\"]"}]},{"id":200,"name":"g-h8","type":"npc","x":216.0,"y":862.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.porter"},{"name":"sprite","type":"string","value":"f_farmer"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Nobody tells the back streets anything. A wedding, you say?”\", \"“什么消息都传不到后街来。你说要办喜事？”\", \"7bccfdfd0b4c\"]]"},{"name":"gossip","type":"string","value":"{\"tells\": [], \"in_beats\": [\"s4\"]}"},{"name":"in","type":"string","value":"[\"news\"]"}]},{"id":201,"name":"g-h10","type":"npc","x":664.0,"y":862.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.elder"},{"name":"sprite","type":"string","value":"f_elder"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Then she doesn't know? Somebody ought to tell her.”\", \"“那她还不知道？得有人去告诉她。”\", \"e1bc6fb59706\"]]"},{"name":"gossip","type":"string","value":"{\"tells\": [\"g-h11\"], \"in_beats\": [\"s4\"]}"},{"name":"in","type":"string","value":"[\"news\"]"}]},{"id":202,"name":"g-h11","type":"npc","x":984.0,"y":862.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_porter"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“A wedding for her own daughter, and she hasn't heard? I'll go round to the gate.”\", \"“亲生女儿要出嫁，她自己还不知道？我这就去府门口说。”\", \"03b33392f088\"]]"},{"name":"gossip","type":"string","value":"{\"tells\": [\"g-h12\"], \"in_beats\": [\"s4\"]}"},{"name":"in","type":"string","value":"[\"news\"]"}]},{"id":203,"name":"g-h12","type":"npc","x":1176.0,"y":862.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.porter"},{"name":"sprite","type":"string","value":"f_farmer"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“A wedding! I'm going to tell the palace guards.”\", \"“是办喜事！我去告诉府门口的守卫。”\", \"b467b37bffd4\"]]"},{"name":"gossip","type":"string","value":"{\"tells\": [\"wu-gatekeeper\"], \"in_beats\": [\"s4\"]}"},{"name":"in","type":"string","value":"[\"news\"]"}]},{"id":204,"name":"wu-gatekeeper","type":"npc","x":1048.0,"y":606.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“The Dowager is at her prayers. Nothing's been said here about any wedding.”\", \"“国太正在念经。这里没人说过什么婚事。”\", \"3ec3d70dd2e8\"]]"},{"name":"in","type":"string","value":"[\"arrival\", \"news\"]"}]},{"id":205,"name":"npc-17","type":"npc","x":792.0,"y":606.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_farmer"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Red cloth everywhere today. Is it a festival?”\", \"“今天到处挂红绸。过节吗？”\", \"f33a2a31768a\"]]"},{"name":"in","type":"string","value":"[\"news\"]"}]},{"id":206,"name":"npc-18","type":"npc","x":856.0,"y":798.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.elder"},{"name":"sprite","type":"string","value":"f_elder2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“The palace is quiet today. The Dowager's at her prayers.”\", \"“国太府今天很安静。国太在念经。”\", \"e7c6745ccb36\"]]"},{"name":"in","type":"string","value":"[\"news\"]"}]},{"id":207,"name":"npc-19","type":"npc","x":600.0,"y":94.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_youth"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Boats from upriver, flying red? What's all that about?”\", \"“上游来的船都挂着红绸？这是怎么回事？”\", \"f47be8230300\"]]"},{"name":"in","type":"string","value":"[\"arrival\", \"news\"]"}]},{"id":208,"name":"npc-20","type":"npc","x":792.0,"y":350.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_farmer"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“My wife says the butchers have sold out by noon.”\", \"“我老婆说，肉铺不到中午就卖光了。”\", \"c2e40b59736c\"]]"},{"name":"in","type":"string","value":"[\"news\"]"}]},{"id":209,"name":"npc-21","type":"npc","x":1240.0,"y":606.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.woman"},{"name":"sprite","type":"string","value":"folk.woman#6"},{"name":"wander","type":"bool","value":false},{"name":"say","type":"string","value":"[[\"n\", \"“I serve in the Dowager's kitchens. Nothing's been said there.”\", \"“我在国太府的厨房干活。那里谁也没提过这事。”\", \"8ec74c12bc74\"]]"},{"name":"in","type":"string","value":"[\"news\"]"}]},{"id":210,"name":"npc-22","type":"npc","x":808.0,"y":606.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_farmer"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Red lanterns on every street. The Marquis's sister is married, and the whole city's had a feast.”\", \"“每条街都挂上了红灯笼。吴侯的妹妹出嫁了，全城都在摆酒。”\", \"a986f59eee75\"]]"},{"name":"in","type":"string","value":"[\"wedding\"]"}]},{"id":211,"name":"npc-23","type":"npc","x":1304.0,"y":606.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Liu Bei's men drill outside the east gate every day. Their general's the one who rode through Changban.”\", \"“刘备的人天天在东门外操练。他们的将军就是在长坂坡杀进杀出的那位。”\", \"c26bc99d9ad9\"]]"},{"name":"in","type":"string","value":"[\"wedding\", \"winter\"]"}]},{"id":212,"name":"npc-24","type":"npc","x":792.0,"y":798.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.elder"},{"name":"sprite","type":"string","value":"f_elder2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Snow on the river. The year's nearly out, and Liu Bei hasn't left the east palace since autumn.”\", \"“江上下雪了。一年快过完了，刘备从秋天起就没出过东府。”\", \"2c4d502b32d0\"]]"},{"name":"in","type":"string","value":"[\"winter\"]"}]},{"id":213,"name":"exit-nanxu--sq-hall","type":"exit","x":633.6,"y":301.6,"width":12.8,"height":12.0,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"nanxu--sq-hall"},{"name":"side","type":"string","value":"N"}]},{"id":214,"name":"exit-nanxu--east-palace","type":"exit","x":1113.6,"y":301.6,"width":12.8,"height":12.0,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"nanxu--east-palace"},{"name":"side","type":"string","value":"N"}]},{"id":215,"name":"exit-nanxu--wu-hall","type":"exit","x":1113.6,"y":646.4,"width":12.8,"height":12.0,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"nanxu--wu-hall"},{"name":"side","type":"string","value":"S"},{"name":"open_to","type":"string","value":"[\"told:wu-gatekeeper\"]"},{"name":"refuse","type":"string","value":"[[\"n\", \"Lady Wu's gate is quiet. The news hasn't reached her yet.\", \"国太府门前一片安静。消息还没传到她耳朵里。\", \"e28a2ee0ecbe\"]]"}]},{"id":216,"name":"exit-the-road-to-chaisang","type":"exit","x":0,"y":576,"width":16,"height":64,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"the-road-to-chaisang"},{"name":"side","type":"string","value":"W"}]},{"id":217,"name":"exit-sweet-dew-temple","type":"e