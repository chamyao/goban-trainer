   "kind": "folk.elder",
   "x": 10.5,
   "y": 15.9,
   "say": [
    "An old storyteller taps his clapper-board. “Sit, sit! Tales of the Yellow Heaven…”"
   ]
  },
  {
   "id": "npc-2",
   "kind": "folk.villager",
   "x": 19.5,
   "y": 16.9,
   "say": [
    "“They say the Yellow Turbans wear scarves the colour of the earth.”"
   ],
   "wander": true
  },
  {
   "id": "npc-3",
   "kind": "folk.woman",
   "x": 17.5,
   "y": 12.9,
   "say": [
    "“Liu Bei? The sandal-seller? Kind man. Ears down to his shoulders, you know.”"
   ],
   "wander": true
  },
  {
   "id": "npc-4",
   "kind": "folk.villager",
   "x": 30.5,
   "y": 12.9,
   "say": [
    "“Zhang Fei sells wine and pork. Loud as thunder, but his heart is good.”"
   ]
  },
  {
   "id": "npc-5",
   "kind": "folk.official",
   "x": 12.5,
   "y": 15.9,
   "say": [
    "“The governor wants volunteers. Read the notice.”"
   ]
  }
