e":"1-n2"},{"name":"label","type":"string","value":"The great peach tree"},{"name":"intro","type":"string","value":"[[\"n\", \"Under the great peach tree two old men sit over a weiqi board, one in grey, one in red.\", \"大桃树下，两位老人对坐下棋，一位穿灰衣，一位穿红衣。\", \"53732c470c80\"], [\"say\", \"starred\", \"Three young men, come to swear before Heaven? Heaven is listening. But first, show us how you read the stones.\", \"三位年轻人，要来对天盟誓吗？上天在听着。不过，先让我们看看你们怎么看这盘棋。\", \"fde1e067d60d\"]]"},{"name":"outro","type":"string","value":"[[\"say\", \"stargrey\", \"Good. The road ahead forks, and fortune favours the one who reads it.\", \"好。前路分岔，福气只眷顾看得清路的人。\", \"dca7eae111a1\"], [\"n\", \"When the brothers look up, the two old men are gone. Only the board remains, and a drift of petals.\", \"兄弟三人抬起头时，两位老人已不见踪影，只剩下一盘棋和满地落花。\", \"6d968004473b\"]]"}]},{"id":199,"name":"npc-1","type":"npc","x":344.0,"y":142.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"hero.stargrey"},{"name":"sprite","type":"string","value":"stargrey"},{"name":"wander","type":"bool","value":false},{"name":"say","type":"string","value":"[[\"n\", \"The old man in grey studies the board and says nothing.\", \"灰衣老人凝视着棋盘，一言不发。\", \"077d511a1e41\"]]"},{"name":"until","type":"string","value":"1-n2"},{"name":"face","type":"string","value":"right"}]},{"id":200,"name":"npc-2","type":"npc","x":344.0,"y":206.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"hero.starred"},{"name":"sprite","type":"string","value":"starred"},{"name":"wander","type":"bool","value":false},{"name":"say","type":"string","value":"[[\"say\", \"starred\", \"Patience. Heaven is in no hurry.\", \"别急。上天从不着急。\", \"459bfe207dd5\"]]"},{"name":"until","type":"string","value":"1-n2"},{"name":"face","type":"string","value":"left"}]},{"id":201,"name":"exit-zhuo-county","type":"exit","x":0,"y":176,"width":16,"height":32,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"zhuo-county"},{"name":"side","type":"string","value":"W"}]},{"id":202,"name":"exit-road-to-julu","type":"exit","x":496,"y":144,"width":16,"height":32,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"road-to-julu"},{"name":"side","type":"string","value":"E"}]},{"id":203,"name":"exit-horse-trail","type":"exit","x":496,"y":256,"width":16,"height":32,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"horse-trail"},{"name":"side","type":"string","value":"E"}]},{"id":204,"name":"entry-zhuo-county","type":"entry","x":40.0,"y":206.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"from","type":"string","value":"zhuo-county"}]},{"id":205,"name":"entry-road-to-julu","type":"entry","x":472.0,"y":174.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"from","type":"string","value":"road-to-julu"}]},{"id":206,"name":"entry-horse-trail","type":"entry","x":472.0,"y":286.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"from","type":"string","value":"horse-trail"}]},{"id":207,"name":"entry","type":"entry","x":280.0,"y":190.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true}]}]}