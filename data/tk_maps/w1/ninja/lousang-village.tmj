:488.0,"y":384,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"rock.small"},{"name":"fw","type":"int","value":16},{"name":"fh","type":"int","value":16},{"name":"solid","type":"bool","value":false}]},{"id":234,"name":"rock.small#0","type":"prop","x":328.0,"y":336,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"rock.small"},{"name":"fw","type":"int","value":16},{"name":"fh","type":"int","value":16},{"name":"solid","type":"bool","value":false}]},{"id":235,"name":"mulberry","type":"spot","x":304,"y":155.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"1-start"},{"name":"label","type":"string","value":"The great mulberry tree"},{"name":"label_zh","type":"string","value":"大桑树"}]},{"id":236,"name":"npc-1","type":"npc","x":328.0,"y":206.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.woman"},{"name":"sprite","type":"string","value":"f_woman2"},{"name":"wander","type":"bool","value":true},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Off to sell your sandals in town, Xuande? Mind the road.”\", \"“玄德，又进城卖草鞋？路上小心。”\", \"b32d9724e7dd\"]]"}]},{"id":237,"name":"npc-2","type":"npc","x":312.0,"y":206.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.child"},{"name":"sprite","type":"string","value":"f_child"},{"name":"wander","type":"bool","value":true},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“That mulberry looks like a carriage canopy! Mother says someone from this house will ride under one.”\", \"“那棵桑树长得像车盖！娘说，这家将来要出贵人。”\", \"8a328a305e1c\"]]"}]},{"id":238,"name":"npc-3","type":"npc","x":360.0,"y":190.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.girl"},{"name":"sprite","type":"string","value":"f_girl"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Brother Xuande! When you're rich, will you buy me a hairpin with a flower on it?”\", \"“玄德哥哥！等你富贵了，给我买一支带花的簪子好不好？”\", \"1a2a174074bb\"]]"}]},{"id":239,"name":"npc-4","type":"npc","x":344.0,"y":158.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.elder"},{"name":"sprite","type":"string","value":"f_elder"},{"name":"wander","type":"bool","value":true},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“The Yellow Turbans are burning villages in the south. Strange times.”\", \"“黄巾贼在南边烧村子，真是乱世啊。”\", \"0333778ec378\"]]"}]},{"id":240,"name":"npc-5","type":"npc","x":312.0,"y":190.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_porter"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"neighbour"},{"name":"intro","type":"string","value":"[[\"n\", \"Your neighbour has scratched a weiqi board into the dirt under the mulberry. “Before you go to town, Xuande, one game.”\", \"邻居在桑树下的泥地上画了一张棋盘。“玄德，进城之前，先下一局。”\", \"4d5fe76c864b\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“Ha! Sharper than your sandals. Go on, then.”\", \"“哈！你的棋比你的草鞋还精。去吧。”\", \"2b9de6ac843a\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"“Bring me back a story from town.”\", \"“从城里带个新鲜事回来给我听。”\", \"1e33211aac02\"]]"}]},{"id":241,"name":"exit-zhuo-county","type":"exit","x":560,"y":240,"width":16,"height":32,"rotation":0,"visible":true,"proper