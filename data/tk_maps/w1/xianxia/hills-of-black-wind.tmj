"name":"outro","type":"string","value":"[[\"n\", \"The glow settles. Only the board remains, and a thread of incense.\", \"微光渐息，只剩棋盘，和一缕香烟。\", \"8787515a5d36\"]]"}]},{"id":139,"name":"ridge_left","type":"spot","x":184.0,"y":363.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":""},{"name":"label","type":"string","value":"The left ridge"},{"name":"label_zh","type":"string","value":"左边的山岭"},{"name":"trigger","type":"string","value":"talk"},{"name":"use","type":"string","value":"ridge"}]},{"id":140,"name":"ridge_right","type":"spot","x":552.0,"y":347.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":""},{"name":"label","type":"string","value":"The right ridge"},{"name":"label_zh","type":"string","value":"右边的山岭"},{"name":"trigger","type":"string","value":"talk"},{"name":"use","type":"string","value":"ridge"}]},{"id":141,"name":"npc-1","type":"npc","x":424.0,"y":270.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_farmer2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“The black wind took my roof. Take the pigs' blood, if it ends this.”\", \"“黑风掀了我的屋顶。若能破了妖风，猪血你们尽管拿去。”\", \"96c6c1a1cc66\"]]"}]},{"id":142,"name":"npc-2","type":"npc","x":488.0,"y":254.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.elder"},{"name":"sprite","type":"string","value":"f_elder2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“My flock hasn't grazed since the storm. Take a sheep, general. Take what you need.”\", \"“羊群自风起后便没吃过草。将军要多少，只管取去。”\", \"19ae981a3476\"]]"}]},{"id":143,"na