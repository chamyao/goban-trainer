,"name":"plant.bush#0","type":"prop","x":120.0,"y":336,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"plant.bush"},{"name":"fw","type":"int","value":16},{"name":"fh","type":"int","value":16},{"name":"solid","type":"bool","value":false}]},{"id":133,"name":"plant.bush#0","type":"prop","x":600.0,"y":416,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"plant.bush"},{"name":"fw","type":"int","value":16},{"name":"fh","type":"int","value":16},{"name":"solid","type":"bool","value":false}]},{"id":134,"name":"plant.bush#0","type":"prop","x":72.0,"y":80,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"plant.bush"},{"name":"fw","type":"int","value":16},{"name":"fh","type":"int","value":16},{"name":"solid","type":"bool","value":false}]},{"id":135,"name":"plant.bush#0","type":"prop","x":280.0,"y":176,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"plant.bush"},{"name":"fw","type":"int","value":16},{"name":"fh","type":"int","value":16},{"name":"solid","type":"bool","value":false}]},{"id":136,"name":"plant.bush#0","type":"prop","x":264.0,"y":128,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"plant.bush"},{"name":"fw","type":"int","value":16},{"name":"fh","type":"int","value":16},{"name":"solid","type":"bool","value":false}]},{"id":137,"name":"altar","type":"spot","x":312.0,"y":219.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"1-n7"},{"name":"label","type":"string","value":"Zhang Bao's sorcery"},{"name":"label_zh","type":"string","value":"张宝的妖术"}]},{"id":138,"name":"shrine","type":"spot","x":304,"y":155.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"1-n7b"},{"name":"label","type":"string","value":"The shrine under the pine"},{"name":"label_zh","type":"string","value":"松下星君祠"},{"name":"intro","type":"string","value":"[[\"n\", \"Under the old pine by the road, a game has been laid out on the little shrine's offering table, with wine cups and dried meat beside it.\", \"路旁老松树下，小祠的供桌上摆开了一局棋，旁边放着酒杯和肉脯。\", \"c83a0f17b4f4\"]]"},{"name":"outro","type":"string","value":"[[\"n\", \"The old men are gone. Only the game remains.\", \"两位老人已经不见了，只剩下那盘棋。\", \"c6587ef3c8e2\"]]"}]},{"id":139,"name":"ridge_left","type":"spot","x":184.0,"y":363.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":""},{"name":"label","type":"string","value":"The left ridge"},{"name":"label_zh","type":"string","value":"左边的山岭"},{"name":"trigger","type":"string","value":"talk"},{"name":"use","type":"string","value":"ridge"},{"name":"needs","type":"string","value":"[\"item:pigblood\", \"item:sheepblood\", \"item:dogblood\"]"},{"name":"delivers","type":"string","value":"ridge_left"},{"name":"when","type":"string","value":"node:n7b"},{"name":"empty","type":"string","value":"[[\"n\", \"The ridge is empty. Go to the shrine under the pine first.\", \"山岭上空无一人。先去松树下的星君祠。\", \"d4b7a89e765d\"]]"},{"name":"waiting","type":"string","value":"[[\"say\", \"guanyu\", \"We hold the ridge. The blood is still to come.\", \"山岭我们守着。血还没送到。\", \"2e7edf458fd4\"]]"},{"name":"deliver","type":"string","value":"[[\"say\", \"guanyu\", \"Blood and filth for every paper horse. We wait for the gun.\", \"纸人纸马，一个也不放过。只等炮响。\", \"2a7f3886e2c7\"]]"},{"name":"call","type":"string","value":"[[\"say\", \"guanyu\", \"Brother! Is that the blood? Up here, quickly!\", \"兄长！那是血吗？快送上来！\", \"ab8cc34e5cb7\"]]"}]},{"id":140,"name":"ridge_right","type":"spot","x":552.0,"y":347.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":""},{"name":"label","type":"string","value":"The right ridge"},{"name":"label_zh","type":"string","value":"右边的山岭"},{"name":"trigger","type":"string","value":"talk"},{"name":"use","type":"string","value":"ridge"},{"name":"needs","type":"string","value":"[\"item:pigblood\", \"item:sheepblood\", \"item:dogblood\"]"},{"name":"delivers","type":"string","value":"ridge_right"},{"name":"when","type":"string","value":"node:n7b"},{"name":"empty","type":"string","value":"[[\"n\", \"The ridge is empty. Go to the shrine under the pine first.\", \"山岭上空无一人。先去松树下的星君祠。\", \"d4b7a89e765d\"]]"},{"name":"waiting","type":"string","value":"[[\"say\", \"zhangfei\", \"A thousand men, and nothing to throw. Hurry, brother.\", \"一千人在此，手里没东西可泼。哥哥快些。\", \"641102cf6a80\"]]"},{"name":"deliver","type":"string","value":"[[\"say\", \"zhangfei\", \"Let his spirits come. I'll soak every one.\", \"叫他的鬼兵来吧，我一个个泼透。\", \"818e51673d52\"]]"},{"name":"call","type":"string","value":"[[\"say\", \"zhangfei\", \"Brother! Is that the blood? Bring it up here!\", \"兄长！可是血来了？快拿上来！\", \"269bd5157e13\"]]"}]},{"id":141,"name":"npc-1","type":"npc","x":424.0,"y":270.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_farmer2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“The black wind has been bad this month.”\", \"“这个月黑风厉害。”\", \"f043e85338d1\"]]"},{"name":"gives","type":"string","value":"pigblood"},{"name":"gives_when","type":"string","value":"node:n7b"},{"name":"give","type":"string","value":"[[\"n\", \"“The black wind took my roof. Take the pigs' blood, if it ends this.”\", \"“黑风掀了我的屋顶。若能破了妖风，猪血你们尽管拿去。”\", \"96c6c1a1cc66\"]]"},{"name":"given","type":"string","value":"[[\"n\", \"“You have my pigs' blood. Go, and stop this wind.”\", \"“猪血你们已经拿走了。去吧，把这风止住。”\", \"25f688c93ba8\"]]"},{"name":"call","type":"string","value":"[[\"n\", \"“General! The pigs' blood is ready for you!”\", \"“将军！猪血给您备好了！”\", \"d42befdbadec\"]]"}]},{"id":142,"name":"npc-2","type":"npc","x":488.0,"y":254.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.elder"},{"name":"sprite","type":"string","value":"f_elder2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Keep off the hills, general.”\", \"“将军，别上那座山。”\", \"3edf1f0e5945\"]]"},{"name":"gives","type":"string","value":"sheepblood"},{"name":"gives_when","type":"string","value":"node:n7b"},{"name":"give","type":"string","value":"[[\"n\", \"“My flock hasn't grazed since the storm. Take a sheep, general. Take what you need.”\", \"“羊群自风起后便没吃过草。将军要多少，只管取去。”\", \"19ae981a3476\"]]"},{"name":"given","type":"string","value":"[[\"n\", \"“You've had the best of my flock, general. Go on.”\", \"“我羊群里最好的已经给你了，将军，去吧。”\", \"cd78c55d77d6\"]]"},{"name":"call","type":"string","value":"[[\"n\", \"“General, over here! Take a sheep, if it helps.”\", \"“将军，这边！要羊血尽管拿去。”\", \"6af91a3b331c\"]]"}]},{"id":143,"name":"npc-3","type":"npc","x":424.0,"y":254.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.hunter"},{"name":"sprite","type":"string","value":"f_hunter"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“My hounds won't go near that hill.”\", \"“我的猎犬不肯近那座山。”\", \"e0f072a7599e\"]]"},{"name":"gives","type":"string","value":"dogblood"},{"name":"gives_when","type":"string","value":"node:n7b"},{"name":"give","type":"string","value":"[[\"n\", \"“My hounds won't go near that hill. If their blood breaks the spell, take it.”\", \"“我的猎犬不肯近那座山。若用狗血能破法，你们拿去。”\", \"2e7dd895090d\"]]"},{"name":"given","type":"string","value":"[[\"n\", \"“You have the dog's blood. May it do what it must.”\", \"“狗血你们拿去了。但愿它能破了那法。”\", \"fe69d5b7b7e5\"]]"},{"name":"call","type":"string","value":"[[\"n\", \"“General! My hounds are yours, if it ends this.”\", \"“将军！只要能了结此事，我的猎犬任您取用。”\", \"0715b05aa4e0\"]]"}]},{"id":144,"name":"npc-4","type":"npc","x":216.0,"y":334.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"hero.guanyu"},{"name":"sprite","type":"string","value":"guanyu"},{"name":"wander","type":"bool","value":false},{"name":"say","type":"string","value":"[[\"say\", \"guanyu\", \"Bring the blood, brother. We hold the left.\", \"兄长，把血送来。左边的山岭我们守着。\", \"9544cd156382\"]]"},{"name":"when","type":"string","value":"node:n7b"}]},{"id":145,"name":"npc-5","type":"npc","x":584.0,"y":334.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"hero.zhangfei"},{"name":"sprite","type":"string","value":"zhangfei"},{"name":"wander","type":"bool","value":false},{"name":"say","type":"string","value":"[[\"say\", \"zhangfei\", \"Bring the blood, brother. We hold the right.\", \"兄长，把血送来。右边的山岭我们守着。\", \"0eadee2ea106\"]]"},{"name":"when","type":"string","value":"node:n7b"}]},{"id":146,"name":"npc-6","type":"npc","x":152.0,"y":334.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Waiting for the gun, sir.”\", \"“只等炮响，将军。”\", \"55ecf6c67f63\"]]"},{"name":"face","type":"string","value":"down"},{"name":"when","type":"string","value":"node:n7b"}]},{"id":147,"name":"npc-7","type":"npc","x":216.0,"y":318.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"strin