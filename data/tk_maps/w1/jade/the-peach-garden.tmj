e":true,"point":true,"properties":[{"name":"kind","type":"string","value":"plant.bush"},{"name":"fw","type":"int","value":16},{"name":"fh","type":"int","value":16},{"name":"solid","type":"bool","value":false}]},{"id":211,"name":"plant.bush#0","type":"prop","x":184.0,"y":288,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"plant.bush"},{"name":"fw","type":"int","value":16},{"name":"fh","type":"int","value":16},{"name":"solid","type":"bool","value":false}]},{"id":212,"name":"plant.bush#0","type":"prop","x":72.0,"y":112,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"plant.bush"},{"name":"fw","type":"int","value":16},{"name":"fh","type":"int","value":16},{"name":"solid","type":"bool","value":false}]},{"id":213,"name":"plant.bush#0","type":"prop","x":344.0,"y":144,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"plant.bush"},{"name":"fw","type":"int","value":16},{"name":"fh","type":"int","value":16},{"name":"solid","type":"bool","value":false}]},{"id":214,"name":"board","type":"spot","x":328.0,"y":171.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"1-n2"},{"name":"label","type":"string","value":"The weiqi board"},{"name":"label_zh","type":"string","value":"围棋盘"},{"name":"trigger","type":"string","value":"talk"},{"name":"intro","type":"string","value":"[[\"n\", \"Under the great peach tree two old men sit over a weiqi board, one in grey, one in red.\", \"大桃树下，两位老人对坐下棋，一位穿灰衣，一位穿红衣。\", \"53732c470c80\"], [\"say\", \"starred\", \"Three young men, come to swear before Heaven? Heaven is listening. But first, show us how you read the stones.\", \"三位年轻人，要来对天盟誓吗？上天在听着。不过，先让我们看看你们怎么看这盘棋。\", \"fde1e067d60d\"], [\"say\", \"stargrey\", \"Fortune favours the one who reads the stones.\", \"能看懂这盘棋的人，自有天佑。\", \"1a1680eb6987\"]]"},{"name":"outro","type":"string","value":"[[\"n\", \"When the brothers look up, the two old men are gone. Only the board remains, and a drift of petals.\", \"兄弟三人抬起头时，两位老人已不见踪影，只剩下一盘棋和满地落花。\", \"6d968004473b\"]]"}]},{"id":215,"name":"npc-1","type":"npc","x":360.0,"y":190.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"hero.stargrey"},{"name":"sprite","type":"string","value":"stargrey"},{"name":"wander","type":"bool","value":false},{"name":"say","type":"string","value":"[[\"n\", \"The old man in grey studies the board and says nothing.\", \"灰衣老人凝视着棋盘，一言不发。\", \"077d511a1e41\"]]"},{"name":"until","type":"string","value":"1-n2"},{"name":"face","type":"string","value":"right"}]},{"id":216,"name":"npc-2","type":"npc","x":344.0,"y":158.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"hero.starred"},{"name":"sprite","type":"string","value":"starred"},{"name":"wander","type":"bool","value":false},{"name":"say","type":"string","value":"[[\"say\", \"starred\", \"Patience. Heaven is in no hurry.\", \"别急。上天从不着急。\", \"459bfe207dd5\"]]"},{"name":"until","type":"string","value":"1-n2"},{"name":"face","type":"string","value":"left"}]},{"id":217,"name":"exit-zhuo-county","type":"exit","x":0,"y":176,"width":16,"height":32,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"zhuo-county"},{"name":"side","type":"string","value":"W"}]},{"id":218,"name":"exit-horse-trail","type":"exit","x":496,"y":192,"width":16,"height":32,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"horse-trail"},{"name":"side","type":"string","value":"E"}]},{"id":219,"name":"entry-zhuo-county","type":"entry","x":40.0,"y":206.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"from","type":"string","value":"zhuo-county"}]},{"id":220,"name":"entry-horse-trail","type":"entry","x"