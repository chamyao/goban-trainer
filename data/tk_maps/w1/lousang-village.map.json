   "kind": "folk.woman",
   "x": 20.5,
   "y": 12.9,
   "say": [
    "“Off to sell your sandals in town, Xuande? Mind the road.”"
   ],
   "wander": true
  },
  {
   "id": "npc-2",
   "kind": "folk.child",
   "x": 19.5,
   "y": 12.9,
   "say": [
    "“That mulberry looks like a carriage canopy! Mother says someone from this house will ride under one.”"
   ],
   "wander": true
  },
  {
   "id": "npc-3",
   "kind": "folk.girl",
   "x": 22.5,
   "y": 11.9,
   "say": [
    "“Brother Xuande! When you're rich, will you buy me a hairpin with a flower on it?”"
   ]
  },
  {
   "id": "npc-4",
   "kind": "folk.elder",
   "x": 21.5,
   "y": 9.9,
   "say": [
    "“The Yellow Turbans are burning villages in the south. Strange times.”"
   ],
   "wander": true
  },
  {
