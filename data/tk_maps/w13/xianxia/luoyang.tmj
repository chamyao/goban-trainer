":"string","value":"董卓治下的街市"},{"name":"trigger","type":"string","value":"near"}]},{"id":287,"name":"c17","type":"spot","x":1240.0,"y":539.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"13-c17"},{"name":"label","type":"string","value":"The East Gate"},{"name":"label_zh","type":"string","value":"东门"},{"name":"trigger","type":"string","value":"near"}]},{"id":288,"name":"xf-gate","type":"spot","x":344.0,"y":923.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":""},{"name":"label","type":"string","value":"The Chancellor's gate"},{"name":"label_zh","type":"string","value":""}]},{"id":289,"name":"npc-1","type":"npc","x":792.0,"y":542.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_farmer2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Xiliang horsemen ride down the middle of the street. You step aside or you're ridden down.”\", \"“西凉兵马当街驰过。不让开，就被踏死。”\", \"43ee43820345\"]]"},{"name":"in","type":"string","value":"[\"dong\"]"}]},{"id":290,"name":"npc-2","type":"npc","x":408.0,"y":542.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.official"},{"name":"sprite","type":"string","value":"f_official"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Zheng Tai went, and Lu Zhi went. A man with a family stays, and bows, and says nothing.”\", \"“郑泰走了，卢植也走了。有家小的人只能留下，低头，不说话。”\", \"76d714d98e9c\"]]"},{"name":"in","type":"string","value":"[\"dong\"]"}]},{"id":291,"name":"npc-3","type":"npc","x":728.0,"y":478.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.maiden"},{"name":"sprite","type":"string","value":"f_maiden2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“The old emperor sits in the tower of Yong'an Palace. They say he wrote a poem about two swallows.”\", \"“旧天子住在永安宫的楼上。听说他写了一首诗，说的是两只燕子。”\", \"a99fa93da140\"]]"},{"name":"until","type":"string","value":"13-c14"},{"name":"in","type":"string","value":"[\"dong\"]"}]},{"id":292,"name":"npc-4","type":"npc","x":744.0,"y":478.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.maiden"},{"name":"sprite","type":"string","value":"f_maiden"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“The Prince of Hongnong is dead. They don't say how. No one asks.”\", \"“弘农王死了。没说怎么死的。也没人敢问。”\", \"4d9cef88acbb\"]]"},{"name":"when","type":"string","value":"node:c14"},{"name":"in","type":"string","value":"[\"dong\"]"}]},{"id":293,"name":"npc-5","type":"npc","x":1112.0,"y":734.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.elder"},{"name":"sprite","type":"string","value":"f_elder"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Carts came in from Yangcheng with heads hung under them. ‘Bandits,’ they said. It was market day there.”\", \"“车从阳城回来，车下挂着人头。说是‘贼’。那天阳城正赶社。”\", \"b9c637972192\"]]"},{"name":"when","type":"string","value":"node:c13"},{"name":"in","type":"string","value":"[\"dong\"]"}]},{"id":294,"name":"npc-6","type":"npc","x":792.0,"y":478.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“The Jiade Gate is shut. The general went in to see the Empress, and he's not come out.”\", \"“嘉德门关了。大将军进去见太后，到现在还没出来。”\", \"a0e47e3b742f\"]]"},{"name":"in","type":"string","value":"[\"court\"]"}]},{"id":295,"name":"npc-7","type":"npc","x":344.0,"y":542.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_farmer"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“The Ten Attendants and He Jin both want the court. Whoever wins, we pay.”\", \"“十常侍要朝廷，何进也要朝廷。不管谁赢，遭殃的都是我们。”\", \"18e5f6d20e62\"]]"},{"name":"in","type":"string","value":"[\"court\"]"}]},{"id":296,"name":"cavalryman","type":"npc","x":808.0,"y":542.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"cavalryman"},{"name":"until","type":"string","value":"13-c16"},{"name":"when","type":"string","value":"node:c12"},{"name":"view","type":"string","value":"4"},{"name":"intro","type":"string","value":"[[\"n\", \"A Xiliang horseman wheels in front of you. “Colonel Cao. The Chancellor's man, now? Prove you can think as well as bow.”\", \"一名西凉骑兵勒马挡在你面前。“曹校尉。如今也是相国的人了？证明你不光会鞠躬，也会动脑子。”\", \"d3a9b6670bc9\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“Huh. Not a fool, then.”\", \"“哼。倒不是个蠢人。”\", \"b4af8ee2206d\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"The horseman rides on down the middle of the street.\", \"骑兵沿着街心驰去。\", \"f512ec34dfaf\"]]"}]},{"id":297,"name":"resigned","type":"npc","x":1048.0,"y":734.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.official"},{"name":"sprite","type":"string","value":"f_official"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"resigned"},{"name":"until","type":"string","value":"13-c16"},{"name":"when","type":"string","value":"node:c12"},{"name":"view","type":"string","value":"4"},{"name":"intro","type":"string","value":"[[\"n\", \"An old official sits at the market go table in a plain robe. “I resigned with Lu Zhi. Sit, Colonel, and tell me with stones why you didn't.”\", \"一位穿着素袍的老官坐在市中棋桌旁。“我随卢植辞了官。坐吧，校尉，用棋子告诉我，你为什么没走。”\", \"08ac61c3351c\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“…So you have a plan of your own. Good. Don't tell me.”\", \"“……原来你自有打算。好。不必告诉我。”\", \"c461bd480217\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"“Go on, Colonel. Whatever you mean to do, do it well.”\", \"“去吧，校尉。不管你要做什么，做好它。”\", \"573739a9b18c\"]]"}]},{"id":298,"name":"exit-luoyang--hj-hall","type":"exit","x":217.6,"y":493.6,"width":12.8,"height":12.0,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"luoyang--hj-hall"},{"name":"side","type":"string","value":"N"}]},{"id":299,"name":"exit-luoyang--wyl-rearhall","type":"exit","x":377.6,"y":493.6,"width":12.8,"height":12.0,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"luoyang--wyl-rearhall"},{"name":"side","type":"string","value":"N"}]},{"id":300,"name":"exit-luoyang--palace","type":"exit","x":697.6,"y":429.6,"width":12.8,"height":12.0,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"luoyang--palace"},{"name":"side","type":"string","value":"N"}]},{"id":301,"name":"exit-luoyang--xiangfu","type":"exit