{"type":"map","version":"1.10","tiledversion":"1.10.2","orientation":"orthogonal","renderorder":"right-down","width":88,"height":68,"tilewidth":16,"tileheight":16,"infinite":false,"nextlayerid":6,"nextobjectid":313,"properties":[{"name":"kit","type":"string","value":"xianxia"},{"name":"source","type":"string","value":"luoyang.map.json"},{"name":"states","type":"string","value":"[{\"id\": \"court\", \"light\": \"day\", \"exits_closed\": [\"beimang\", \"the-camps\", \"the-east-road\"], \"exits_closed_say\": {\"beimang\": [[\"n\", \"The north gate is shut. The whole city waits on He Jin.\", \"北门已闭。满城都在等何进的动静。\", \"880f36b67922\"]], \"the-camps\": [[\"n\", \"Outside the walls is no place for a colonel today. He Jin's council is sitting.\", \"今日不是校尉出城的时候。何进府中正在议事。\", \"8fa86723c301\"]], \"the-east-road\": [[\"n\", \"Not now. The council is sitting at He Jin's.\", \"现在不行。何进府中正在议事。\", \"c94fd8b8706d\"]]}}, {\"id\": \"burning\", \"when\": \"node:c2\", \"until\": \"node:c3\", \"light\": \"night\", \"weather\": \"smoke\", \"exits_closed\": [\"beimang\", \"the-camps\", \"the-east-road\"], \"exits_closed_say\": {\"beimang\": [[\"n\", \"The gates are barred. The Emperor is somewhere inside the burning palace.\", \"城门已闩。天子还在火海般的宫中某处。\", \"6993df04e225\"]], \"the-camps\": [[\"n\", \"The gates are barred. The Emperor is somewhere inside the burning palace.\", \"城门已闩。天子还在火海般的宫中某处。\", \"6993df04e225\"]], \"the-east-road\": [[\"n\", \"The gates are barred. The Emperor is somewhere inside the burning palace.\", \"城门已闩。天子还在火海般的宫中某处。\", \"6993df04e225\"]]}}, {\"id\": \"dong\", \"when\": \"node:c5\", \"until\": \"node:c16\", \"banners\": \"black\", \"light\": \"day\", \"exits_closed\": [\"beimang\", \"the-east-road\"], \"exits_closed_say\": {\"beimang\": [[\"n\", \"Xiliang horsemen hold the north gate. No one leaves without Dong Zhuo's word.\", \"西凉铁骑把守北门。没有董卓的话，谁也出不去。\", \"406cc37542aa\"]], \"the-east-road\": [[\"n\", \"Xiliang horsemen hold the East Gate. No one leaves without Dong Zhuo's word.\", \"西凉铁骑把守东门。没有董卓的话，谁也出不去。\", \"72f1f0a75e15\"]]}}, {\"id\": \"sword\", \"when\": \"node:c16\", \"until\": \"node:c17\", \"banners\": \"black\", \"light\": \"day\", \"exits_closed\": [\"beimang\", \"the-camps\", \"the-east-road\"], \"exits_closed_say\": {\"beimang\": [[\"n\", \"Not that way. East, out of the city, before they think to send for you.\", \"不是那边。往东出城，趁他们还没想起来派人找你。\", \"a78fb2fa6dbb\"]], \"the-camps\": [[\"n\", \"Not that way. East, out of the city, before they think to send for you.\", \"不是那边。往东出城，趁他们还没想起来派人找你。\", \"a78fb2fa6dbb\"]], \"the-east-road\": [[\"n\", \"The East Gate is ahead. Ride up to it as if you had every right.\", \"东门就在前面。大大方方地骑过去，仿佛理所当然。\", \"7a838f05ecef\"]]}}, {\"id\": \"wanted\", \"when\": \"node:c17\", \"banners\": \"black\", \"light\": \"day\", \"exits_closed\": [\"beimang\", \"the-camps\"], \"exits_closed_say\": {\"beimang\": [[\"n\", \"Your face is on every gate in Luoyang now. East, and keep going.\", \"如今洛阳每座城门都挂着你的画像。往东，不要停。\", \"b6d74038f4ec\"]], \"the-camps\": [[\"n\", \"Your face is on every gate in Luoyang now. East, and keep going.\", \"如今洛阳每座城门都挂着你的画像。往东，不要停。\", \"b6d74038f4ec\"]]}}]"},{"name":"ways","type":"string","value":"{\"nodes\":[[2.0,34.0],[10.0,34.0],[30.0,34.0],[34.0,34.0],[54.0,34.0],[66.0,34.0],[78.0,34.0],[86.0,34.0],[66.0,2.0],[30.0,10.0],[10.0,58.0],[34.0,58.0],[54.0,58.0],[78.0,58.0]],\"edges\":[[0,1],[1,2],[1,10],[2,3],[2,9],[3,4],[3,11],[4,5],[4,12],[5,6],[5,8],[6,7],[6,13],[10,11],[11,12],[12,13]]}"},{"name":"chase","type":"string","value":"{\"chase\":\"c17\",\"state\":\"sword\",\"from\":[21.5,57.7],\"to\":[77.5,33.7],\"pace\":{\"horse\":165,\"wave\":150,\"wave_after\":1.0,\"ambusher\":140,\"reach\":9,\"lead\":0.1,\"hold\":1.0,\"hit\":0.8},\"wave\":{\"from\":[21.5,57.7],\"kind\":\"folk.soldier\",\"count\":8},\"ambush\":[{\"id\":\"side-gate\",\"post\":[30.0,46.0],\"to\":[38.0,46.0],\"dash\":\"E\",\"kind\":\"folk.soldier\"},{\"id\":\"jiade\",\"post\":[45.5,29.5],\"to\":[45.5,36.5],\"dash\":\"S