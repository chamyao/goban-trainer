me":"node","type":"string","value":"13-c18"},{"name":"label","type":"string","value":"The pass at Zhongmou"},{"name":"label_zh","type":"string","value":"中牟关"},{"name":"trigger","type":"string","value":"near"}]},{"id":117,"name":"npc-1","type":"npc","x":664.0,"y":350.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_youth"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“They say he tried to kill the Chancellor with a jewelled sword. A thousand gold for him, and a marquisate.”\", \"“听说他拿一口宝刀要刺相国。拿住他赏千金，封万户侯。”\", \"6b85de803343\"]]"}]},{"id":118,"name":"npc-2","type":"npc","x":2008.0,"y":414.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.elder"},{"name":"sprite","type":"string","value":"f_elder2"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Our magistrate came from Dongjun. He keeps his own counsel.”\", \"“我们县令是东郡人。心里有主意，从不多说。”\", \"c91c0f4dc8e2\"]]"}]},{"id":119,"name":"post-guard","type":"npc","x":472.0,"y":286.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"post-guard"},{"name":"until","type":"string","value":"13-c18"},{"name":"when","type":"string","value":"node:c17"},{"name":"view","type":"string","value":"4"},{"name":"guard_x","type":"float","value":544.0},{"name":"guard_y","type":"float","value":288.0},{"name":"intro","type":"string","value":"[[\"n\", \"The post-station guard holds up the portrait and looks from it to you. “Your name, and your business on this road.”\", \"驿站卫兵举起画像，看看画像又看看你。“报上姓名，在这条路上做什么？”\", \"3ee24357e7ec\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“…No. He'd be older. Go on.”\", \"“……不对。那人该老些。走吧。”\", \"37faf6c17dbd\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"The guard is looking at someone else now.\", \"卫兵已在看别人了。\", \"189ee4eac7d3\"]]"}]},{"id":120,"name":"ferryman","type":"npc","x":920.0,"y":286.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_youth"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"ferryman"},{"name":"until","type":"string","value":"13-c18"},{"name":"when","type":"string","value":"node:c17"},{"name":"view","type":"string","value":"4"},{"name":"guard_x","type":"float","value":1056.0},{"name":"guard_y","type":"float","value":288.0},{"name":"intro","type":"string","value":"[[\"n\", \"The ferryman leans on his pole. “Crossing's a coin. Or a game, if you're short. I've seen your face somewhere, I think.”\", \"船夫倚着篙。“过渡一文钱。手头紧的话，下一局也行。我好像在哪里见过你这张脸。”\", \"df7e8dd643dd\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“…No, I haven't. Get in.”\", \"“……没有，没见过。上船吧。”\", \"eba2a120f5f5\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"“Same price as before, sir.”\", \"“还是老价钱，客官。”\", \"fc1ade8dcd39\"]]"}]},{"id":121,"name":"bounty","type":"npc","x":1304.0,"y":350.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.hunter"},{"name":"sprite","type":"string","value":"f_hunter"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"bounty"},{"name":"until","type":"string","value":"13-c18"},{"name":"when","type":"string","value":"node:c17"},{"name":"view","type":"string","value":"4"},{"name":"intro","type":"string","value":"[[\"n\", \"A man with the portrait folded in his belt falls in beside you. “A thousand gold. Thinking of it makes a man sharp.”\", \"一个腰里折着画像的人凑到你身旁。“千金啊。一想到这个，人就机灵起来了。”\", \"97bc2e7d8fa7\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“…Not sharp enough, it seems.”\", \"“……看来还不够机灵。”\", \"73c6107e6f80\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"The bounty hunter studies every face that passes.\", \"赏金客打量着每一张过路的脸。\", \"0f4a4d92d6bd\"]]"}]},{"id":122,"name":"exit-the-east-road--jail-court","type":"exit","x":1936,"y":173.6,"width":32,"height":7.2,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"the-east-road--jail-court"},{"name":"side","type":"string","value":"N"}]},{"id":123,"name":"exit-luoyang","type":"exit","x":0,"y":256,"width":16,"height":64,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"luoyang"},{"name":"side","type":"string","value":"W"}]},{"id":124,"name":"exit-chenggao","type":"exit","x":2288,"y":256,"width":16,"height":64,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"chenggao"},{"name":"side","type":"string","value":"E"}]},{"id":125,"name":"entry-the-east-road--jail-court","type":"entry","x":1960.0,"y":190.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"from","type":"string","value":"the-east-road--jail-court"}]},{"id":126,"name":"entry-luoyang","type":"entry","x":88.0,"y":286.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"from","type":"string","value":"luoyang"}]},{"id":127,"name":"entry-chenggao","type":"entry","x":2200.0,"y":286.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"from","type":"string","value":"chenggao