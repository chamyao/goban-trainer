04.0,"y":528,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"tree.willow"},{"name":"fw","type":"int","value":16},{"name":"fh","type":"int","value":16},{"name":"solid","type":"bool","value":true}]},{"id":19,"name":"tree.willow#0","type":"prop","x":984.0,"y":448,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"tree.willow"},{"name":"fw","type":"int","value":16},{"name":"fh","type":"int","value":16},{"name":"solid","type":"bool","value":true}]},{"id":20,"name":"tree.willow#0","type":"prop","x":1032.0,"y":528,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"tree.willow"},{"name":"fw","type":"int","value":16},{"name":"fh","type":"int","value":16},{"name":"solid","type":"bool","value":true}]},{"id":21,"name":"tree.willow#0","type":"prop","x":1160.0,"y":528,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"tree.willow"},{"name":"fw","type":"int","value":16},{"name":"fh","type":"int","value":16},{"name":"solid","type":"bool","value":true}]},{"id":22,"name":"tree.willow#0","type":"prop","x":1240.0,"y":448,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"tree.willow"},{"name":"fw","type":"int","value":16},{"name":"fh","type":"int","value":16},{"name":"solid","type":"bool","value":true}]},{"id":23,"name":"c23","type":"spot","x":856.0,"y":603.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"13-c23"},{"name":"label","type":"string","value":"The village drilling ground"},{"name":"label_zh","type":"string","value":"村中校场"},{"name":"trigger","type":"string","value":"near"}]},{"id":24,"name":"npc-1","type":"npc","x":168.0,"y":478.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.elder"},{"name":"sprite","type":"string","value":"f_elder"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Money, son. An army eats before it fights.”\", \"“钱啊，儿子。军队打仗之前，先要吃饭。”\", \"9b2f11773cb4\"]]"}]},{"id":25,"name":"npc-2","type":"npc","x":984.0,"y":670.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_farmer"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“They put up a white banner. Loyalty and right. I came for the rice, and I'll stay for the banner.”\", \"“他们竖了一面白旗，上写忠义。我是为米来的，要为这面旗留下。”\", \"612acb91bf20\"]]"},{"name":"in","type":"string","value":"[\"rally\"]"}]},{"id":26,"name":"npc-3","type":"npc","x":600.0,"y":670.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.hunter"},{"name":"sprite","type":"string","value":"f_hunter"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Two thousand of us from the hills, and more coming. Is it true he went at Dong Zhuo with a sword?”\", \"“我们山里来了两千人，后面还有。听说他拿刀去刺董卓，是真的吗？”\", \"3fee564a5c98\"]]"},{"name":"in","type":"string","value":"[\"rally\"]"}]},{"id":27,"name":"swordsman","type":"npc","x":1048.0,"y":670.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"swordsman"},{"name":"when","type":"string","value":"node:c22"},{"name":"view","type":"string","value":"4"},{"name":"intro","type":"string","value":"[[\"n\", \"A volunteer swordsman blocks the recruiter's table. “I'll follow a man who can think. Show me you can.”\", \"一个应募的剑客拦在招兵的桌前。“我只跟会动脑子的人。你证明给我看。”\", \"b15a2938f86a\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“…Put my name down.”\", \"“……把我的名字记上。”\", \"73c823e7d3b5\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"The swordsman is drilling with the others.\", \"剑客正和众人一起操练。\", \"0f066204c028\"]]"}]},{"id":28,"name":"merchant","type":"npc","x":920.0,"y":286.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.villager"},{"name":"sprite","type":"string","value":"f_farmer"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[]"},{"name":"challenge","type":"string","value":"merchant"},{"name":"when","type":"string","value":"node:c22"},{"name":"view","type":"string","value":"4"},{"name":"intro","type":"string","value":"[[\"n\", \"A grain merchant eyes Wei Hong's carts. “An army needs grain, and I have grain. Let's see what kind of bargainer you are.”\", \"一个粮商打量着卫弘的车队。“军队要粮，我有粮。看看你是什么样的买家。”\", \"a8767329f8bb\"]]"},{"name":"win","type":"string","value":"[[\"n\", \"“…Done. Half the price, for the banner.”\", \"“……成交。看在这面旗的份上，半价。”\", \"ab597f273f6d\"]]"},{"name":"done","type":"string","value":"[[\"n\", \"“The carts go out tomorrow, Lord Cao.”\", \"“车队明日出发，曹公。”\", \"03658d4c45a4\"]]"}]},{"id":29,"name":"exit-chenliu--wh-hall","type":"exit","x":473.6,"y":429.6,"width":12.8,"height":12.0,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"chenliu--wh-hall"},{"name":"side","type":"string","value":"N"}]},{"id":30,"name":"exit-chenggao","type":"exit","x":0,"y":448,"width":16,"height":64,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"chenggao"},{"name":"side","type":"string","value":"W"}]},{"id":31,"name":"entry-chenliu--wh-hall","type":"entry","x":488.0,"y":446.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"from","type":"string","value":"chenliu--wh-hall"}]},{"id":32,"name":"entry-chenggao","type":"entry","x":88.0,"y":478.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"from","type":"string","value":"chenggao"}]},{"id":33,"name":"entry","type":"entry","x":88.0,"y":478.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true}]}]}