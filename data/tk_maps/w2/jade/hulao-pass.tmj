el_zh","type":"string","value":"松下星君祠"},{"name":"intro","type":"string","value":"[[\"n\", \"Under the old pine by the camp, a game has been laid out on the little shrine's offering table, with wine cups and dried meat beside it.\", \"营边老松树下，小祠的供桌上摆开了一局棋，旁边放着酒杯和肉脯。\", \"7c22a51b6887\"]]"},{"name":"outro","type":"string","value":"[[\"n\", \"The old men are gone. Only the game remains.\", \"两位老人已经不见了，只剩下那盘棋。\", \"c6587ef3c8e2\"]]"}]},{"id":165,"name":"fortress","type":"spot","x":336,"y":155.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"2-boss"},{"name":"label","type":"string","value":"Lü Bu's gate"},{"name":"label_zh","type":"string","value":"吕布的关门"}]},{"id":166,"name":"zhangfei_post","type":"spot","x":424.0,"y":219.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":""},{"name":"label","type":"string","value":"Zhang Fei's post"},{"name":"label_zh","type":"string","value":"张飞的阵位"},{"name":"needs","type":"string","value":"[\"node:m4b\"]"},{"name":"delivers","type":"string","value":"zhangfei_in"},{"name":"when","type":"string","value":"node:m4b"},{"name":"empty","type":"string","value":"[[\"n\", \"No one is here yet. Go to the shrine under the pine first.\", \"这里还没有人。先去松树下的星君祠。\", \"c51c337a2b41\"]]"},{"name":"deliver","type":"string","value":"[[\"say\", \"zhangfei\", \"Leave Lü Bu to me!\", \"把吕布交给我！\", \"4b9c93882791\"]]"},{"name":"call","type":"string","value":"[[\"say\", \"zhangfei\", \"Elder Brother, over here! Let me at him first!\", \"大哥，这边！让我先上！\", \"c5f1084a4cd1\"]]"}]},{"id":167,"name":"guanyu_post","type":"spot","x":216.0,"y":219.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":""},{"name":"label","type":"string","value":"Guan Yu's post"},{"name":"label_zh","type":"string","value":"关羽的阵位"},{"name":"needs","type":"string","value":"[\"mark:zhangfei_in\"]"},{"name":"delivers","type":"string","value":"guanyu_in"},{"name":"when","type":"string","value":"node:m4b"},{"name":"empty","type":"string","value":"[[\"n\", \"No one is here yet. Go to the shrine under the pine first.\", \"这里还没有人。先去松树下的星君祠。\", \"c51c337a2b41\"]]"},{"name":"waiting","type":"string","value":"[[\"say\", \"guanyu\", \"Yide first. He has been begging for it.\", \"翼德先去。他早就等不及了。\", \"0e62c2d7c500\"]]"},{"name":"deliver","type":"string","value":"[[\"say\", \"guanyu\", \"Then I go in, brother.\", \"那我便上了，兄长。\", \"b7b01c24f82d\"]]"},{"name":"call","type":"string","value":"[[\"say\", \"guanyu\", \"Brother, Yide has him. Now it is my turn.\", \"兄长，翼德已缠住他。轮到我了。\", \"f656003dfa43\"]]"}]},{"id":168,"name":"liubei_flank","type":"spot","x":280.0,"y":203.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":""},{"name":"label","type":"string","value":"The flank"},{"name":"label_zh","type":"string","value":"侧翼"},{"name":"needs","type":"string","value":"[\"mark:guanyu_in\"]"},{"name":"delivers","type":"string","value":"liubei_in"},{"name":"when","type":"string","value":"node:m4b"},{"name":"empty","type":"string","value":"[[\"n\", \"No one is here yet. Go to the shrine under the pine first.\", \"这里还没有人。先去松树下的星君祠。\", \"c51c337a2b41\"]]"},{"name":"waiting","type":"string","value":"[[\"say\", \"liubei\", \"Not yet. Let them hold him first.\", \"还不是时候。先让他们缠住他。\", \"c8702c7806df\"]]"},{"name":"deliver","type":"string","value":"[[\"say\", \"liubei\", \"Now. Together.\", \"现在。一起上。\", \"dbd1e726b30e\"]]"}]},{"id":169,"name":"npc-1","type":"npc","x":312.0,"y":206.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":true},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Lü Bu on Red Hare: they say he can go through a whole army.”\", \"“吕布骑着赤兔马，听说能单骑冲过一支大军。”\", \"3f7d2c399c12\"]]"}]},{"id":170,"name":"exit-sishui-gate","type":"exit","x":0,"y":208,"width":16,"height":32,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"sishui-gate"},{"name":"side","type":"string","value":"W"}]},{"id":171,"name":"exit-burned-luoyang","type":"exit","x":624,"y":208,"width":16,"height":32,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"burned-luoyang"},{"name":"side","type":"string","value":"E"}]},{"id":172,"name":"entry-sishui-gate","type":"entry","x":40.0,"y":238.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"from","type":"string","value":"sishui-gate"}]},{"id":173,"name":"entry-burned-luoyang","type":"entry","x":600.0,"y":238.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"from","type":"string","value":"burned-luoyang"}]},{"id":174,"name":"entry","type":"entry","x":600.0,"y":238.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true}]}]}