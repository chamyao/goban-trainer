.0,11.5]},{"do":"line","line":["say","ms_kimbr","...We'll revise it.","","6a374d7f21d9"],"speaker":"br","face":[{"actor":"br","dir":"right"},{"actor":"ms_jang","dir":"left"}],"camera":[17.5,11.5]},{"do":"fade","actors":["st","br"]},{"do":"line","line":["n","Everyone plays their own baduk. Whoever prepared better is happier with the result. Whoever rushed to keep pace has no excuse.","","90ec2d742795"],"camera":[17.0,11.0]},{"do":"problem"},{"do":"appear","place":[{"actor":"go","at":[17.5,11.85],"face":"right"}]},{"do":"line","line":["say","ms_oh","Why would Steve come down on our department head? Out with it.","","734a9271b38a"],"speaker":"oh","face":[{"actor":"oh","dir":"right"},{"actor":"ms_jang","dir":"left"}],"camera":[17.0,11.0]},{"do":"line","line":["say","ms_go","Steve suggested a dinner with the buyers. I picked the place. I'd had a few.","","af1ce62f6140"],"speaker":"go","face":[{"actor":"go","dir":"right"},{"actor":"ms_jang","dir":"left"}],"camera":[18.0,11.5]},{"do":"line","line":["say","ms_oh","What did you feed them?","","9b5d850ac8c2"],"speaker":"oh","face":[{"actor":"oh","dir":"right"},{"actor":"ms_jang","dir":"left"}],"camera":[17.0,11.0]},{"do":"line","line":["say","ms_go","...Dog meat.","","74eaae87df70"],"speaker":"go","face":[{"actor":"go","dir":"right"},{"actor":"ms_jang","dir":"left"}],"camera":[18.0,11.5]},{"do":"fade","actors":["go","oh"]}],"end":{"leader":[18.5,11.85]},"facing":"left"},"m22b":{"place":"one-international--sales3","spot":"m22b","node":"21-m22b","party":["ms_jang"],"cast":{"ms_jang":{"who":"ms_jang","side":"us"},"oh":{"who":"ms_oh","side":"them"},"kd":{"who":"ms_kimds","side":"them"},"ms_go":{"who":"ms_go","side":"them"},"ms_stevehan":{"who":"ms_stevehan","side":"them"}},"beats":[{"do":"cut","place":[{"actor":"ms_jang","at":[18.5,11.85],"face":"left"}]},{"do":"line","line":["n","Go had taken a buyer, and Steve, to a dog-meat restaurant, and never said sorry. Steve sat on Sales Team 1's approvals.","","b9c1d6f8f7f9"],"camera":[1