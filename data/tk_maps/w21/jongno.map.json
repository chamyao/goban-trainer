   "in": [
    "evening"
   ]
  },
  {
   "id": "npc-7",
   "kind": "folk.salaryman",
   "x": 49.5,
   "y": 41.9,
   "say": [
    "A team dinner spills onto the pavement. “To the director's leadership!” The glasses go up. The director beams."
   ],
   "in": [
    "evening"
   ]
  },
  {
   "id": "npc-8",
   "kind": "folk.salaryman",
   "x": 29.5,
   "y": 29.9,
   "say": [
    "A man smoking by the kerb. “Our department head? Useless. Couldn't find his own—” His phone rings. “Yes, sir! Of course, sir. Right away, sir.”"
   ],
   "in": [
    "evening"
   ]
  },
  {
   "id": "npc-9",
   "kind": "folk.officewoman",
   "x": 89.5,
   "y": 29.9,
   "say": [
    "Two juniors share a cigarette. “Cogs. That's all we are. Ants, carrying crumbs home.”"
   ],
   "in": [
    "evening"
   ]
  },
  {
   "id": "npc-10",
   "kind": "folk.salaryman",
   "x": 17.5,
   "y": 41.9,
   "say": [
    "A drunk sways at the crossing and points at the sky. “See that plane? It's circling Seoul! For me! A genius, you know, one genius feeds thousands!”"
   ],
   "in": [
    "evening"
   ]
  },
