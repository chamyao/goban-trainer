road","type":"spot","x":232.0,"y":315.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"3-m13c"},{"name":"label","type":"string","value":"The Huainan road"},{"name":"label_zh","type":"string","value":"淮南要路"}]},{"id":205,"name":"whitegate","type":"spot","x":384,"y":283.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"3-boss"},{"name":"label","type":"string","value":"The White Gate Tower"},{"name":"label_zh","type":"string","value":"白门楼"}]},{"id":206,"name":"lvbuhall","type":"spot","x":320,"y":363.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"3-a4"},{"name":"label","type":"string","value":"Lü Bu's hall"},{"name":"label_zh","type":"string","value":"吕布厅堂"}]},{"id":207,"name":"houcheng","type":"spot","x":160,"y":203.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":"3-a5"},{"name":"label","type":"string","value":"Hou Cheng's quarters"},{"name":"label_zh","type":"string","value":"侯成住处"}]},{"id":208,"name":"road_west","type":"spot","x":376.0,"y":267.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":""},{"name":"label","type":"string","value":"The west side of the road"},{"name":"label_zh","type":"string","value":"路西"},{"name":"needs","type":"string","value":"[\"node:m13b\"]"},{"name":"delivers","type":"string","value":"road_west"},{"name":"when","type":"string","value":"node:m13b"},{"name":"empty","type":"string","value":"[[\"n\", \"No one is posted here yet. Go to the shrine under the pine first.\", \"这里还没有人把守。先去松树下的星君祠。\", \"4b13a6b56ec9\"]]"},{"name":"deliver","type":"string","value":"[[\"say\", \"guanyu\", \"The west is shut. Let him look for another door.\", \"路西已关。让他另寻门户吧。\", \"ea4637398ed4\"]]"},{"name":"call","type":"string","value":"[[\"say\", \"guanyu\", \"Brother, give me the west side. Nothing will pass me.\", \"兄长，路西交给我。什么也过不去。\", \"37a06b96d2a9\"]]"}]},{"id":209,"name":"road_east","type":"spot","x":88.0,"y":235.2,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"node","type":"string","value":""},{"name":"label","type":"string","value":"The east side of the road"},{"name":"label_zh","type":"string","value":"路东"},{"name":"needs","type":"string","value":"[\"node:m13b\"]"},{"name":"delivers","type":"string","value":"road_east"},{"name":"when","type":"string","value":"node:m13b"},{"name":"empty","type":"string","value":"[[\"n\", \"No one is posted here yet. Go to the shrine under the pine first.\", \"这里还没有人把守。先去松树下的星君祠。\", \"4b13a6b56ec9\"]]"},{"name":"deliver","type":"string","value":"[[\"say\", \"zhangfei\", \"The east is mine. Not even a rabbit gets through.\", \"路东归我。连只兔子也别想过去。\", \"c170a6318969\"]]"},{"name":"call","type":"string","value":"[[\"say\", \"zhangfei\", \"Brother! Put me on the east side. I'll catch whatever comes.\", \"哥哥！让我守路东。来什么捉什么。\", \"ceee68a74789\"]]"}]},{"id":210,"name":"npc-1","type":"npc","x":280.0,"y":318.4,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"kind","type":"string","value":"folk.soldier"},{"name":"sprite","type":"string","value":"f_soldier"},{"name":"wander","type":"bool","value":false},{"name":"drawn","type":"bool","value":true},{"name":"say","type":"string","value":"[[\"n\", \"“Lord Cao says any camp that lets Lü Bu through answers for it by martial law.”\", \"“曹公有令：哪个营寨放走了吕布，军法从事。”\", \"f3a12569ad5b\"]]"}]},{"id":211,"name":"exit-xiaopei","type":"exit","x":0,"y":224,"width":16,"height":32,"rotation":0,"visible":true,"properties":[{"name":"to","type":"string","value":"xiaopei"},{"name":"side","type":"string","value":"W"}]},{"id":212,"name":"exit-xiapi--camp","type":"exit","x":305.6,"y":189.6,"width":12.8,"height":7.2,"rotation":0,"visible":true,"properties":[{"name":"to","type"